{
  "$description": "Design tokens used by the committee redesign mockups (screens/*.html). Map these onto AdminLTE 2 / Bootstrap 3 variables or a small committee.css; do not introduce Bootstrap 5 utilities.",
  "font": {
    "family": "'Hind Siliguri', 'Noto Sans Bengali', sans-serif",
    "familyPrintNotice": "'Tiro Bangla', 'Hind Siliguri', serif",
    "source": "Google Fonts (Hind Siliguri 400/500/600/700, Tiro Bangla 400)",
    "size": { "pageTitle": "30-32px", "sectionTitle": "20-22px", "cardTitle": "17-18px", "body": "15-16px", "meta": "13-14px" },
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "lineHeight": { "body": 1.6, "dense": 1.5 }
  },
  "color": {
    "ink": "#17201D",
    "muted": "#4F5B57",
    "ground": "#F3F5F4",
    "surface": "#FFFFFF",
    "surfaceSubtle": "#F6F8F7",
    "line": "#D9DFDB",
    "lineSoft": "#EEF1EF",
    "inputBorder": "#B7C2BC",
    "header": "#276A93",
    "primary": "#1F5F8B",
    "primaryHover": "#163F5E",
    "primarySoft": "#EEF5FA",
    "primaryChip": "#E6F0F7",
    "overlay": "#5C6763",
    "paper": { "background": "#FFFDF8", "border": "#D8D2C4", "rule": "#B9B2A3" },
    "status": {
      "ready":     { "text": "#1D6B43", "background": "#E4F3EA", "label_bn": "কাজের জন্য প্রস্তুত", "label_en": "Ready to work", "icon": "check" },
      "attention": { "text": "#8A4B00", "background": "#FFF1D9", "border": "#F0C27A", "label_bn": "মনোযোগ প্রয়োজন", "label_en": "Needs attention", "icon": "triangle or clock" },
      "cannotAct": { "text": "#A1261C", "background": "#FCEBE9", "border": "#EFB2AC", "label_bn": "কাজ করতে পারবে না", "label_en": "Can't act", "icon": "x-circle" },
      "otherOffice": { "text": "#5C3B00", "background": "#F7EEDF", "label_bn": "অন্য দপ্তরের সদস্য", "label_en": "Member from another office", "icon": "building" }
    }
  },
  "space": { "pageGutter": "32px", "cardPadding": "18-26px", "gapSmall": "8px", "gap": "12-16px", "gapLarge": "24-28px" },
  "radius": { "card": "12px", "input": "8px", "button": "8px", "chip": "999px", "dialog": "14px" },
  "size": { "minTouchTarget": "44px", "input": "44px", "primaryButton": "46-52px", "avatar": "44-52px", "contentMaxWidth": "1100-1200px", "phoneWidth": "390px" },
  "rules": [
    "Status always shows icon + text, never colour alone.",
    "Every interactive target is at least 44px tall.",
    "Text contrast 4.5:1 or better (muted #4F5B57 on white passes).",
    "Disabled actions stay visible with a reason linked by aria-describedby."
  ]
}
