{
    "name": "gov-store/custom-requests",
    "description": "Custom Request Handling and Processing for Government Store Operations",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "DoICT"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^12.0",
        "illuminate/database": "^12.0",
        "illuminate/validation": "^12.0",
        "gov-store/office-membership": "dev-master",
        "gov-store/tenant-scope": "dev-master",
        "gov-store/store-operations": "dev-master"
    },
    "autoload": {
        "psr-4": {
            "GovStore\\CustomRequests\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "GovStore\\CustomRequests\\Providers\\CustomRequestServiceProvider"
            ]
        }
    }
}
