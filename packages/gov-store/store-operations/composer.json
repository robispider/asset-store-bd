{
    "name": "gov-store/store-operations",
    "description": "Document-Driven Government Store Operations and Inventory Accounting",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "DoICT"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^12.0",
        "illuminate/database": "^12.0",
        "illuminate/validation": "^12.0",
        "illuminate/console": "^12.0",
        "gov-store/tenant-scope": "dev-master",
        "gov-store/metadata": "dev-master"
    },
    "suggest": {
        "gov-store/tracking": "Programme verification and atomic receipt delivery integration",
        "gov-store/committee": "Optional committee purpose registry for future receipt inspection"
    },
    "autoload": {
        "psr-4": {
            "GovStore\\StoreOperations\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "GovStore\\StoreOperations\\Providers\\StoreOperationsServiceProvider"
            ]
        }
    }
}
