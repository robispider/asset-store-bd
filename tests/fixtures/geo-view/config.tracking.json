{
  "contract": "gs-geo-config/1",
  "id": "programme-map",
  "preset": "tracking.programme",
  "intent": "progress",
  "locale": "en",
  "source": { "key": "tracking.programme", "mode": "remote", "params": { "initiative": 30 }, "param_keys": ["initiative", "code", "status", "plan", "q"] },
