  "input": null,
  "boundary": { "version": "bd-boundaries-2026-10-21.1", "base_url": "/vendor/geo-areas/boundaries/bd-boundaries-2026-10-21.1", "root": 9358 },
  "endpoints": { "data": "/gov-store/api/geo-view/sources/tracking.programme/data", "details": "/gov-store/api/geo-view/sources/tracking.programme/details", "children": null, "search": null },
  "strings": { "no_data": "No data" }
