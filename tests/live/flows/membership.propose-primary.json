{
  "schemaVersion": 1,
  "id": "membership.propose-primary",
  "title": "Current approver proposes their office duty to an active colleague",
  "params": {
    "from": {
      "type": "string",
      "required": true
    },
    "to": {
      "type": "string",
      "required": true
    },
    "as": {
      "type": "string",
      "required": true
    }
  },
  "steps": [
    {
      "use": "auth.login",
      "with": {
        "actor": "${params.from}"
      }
    },
    {
      "action": "goto",
      "url": "/gov-store/my-memberships"
    },
    {
      "action": "assert",
      "target": "css=#your-roles form[action$=\"/cancel\"]",
      "test": "count",
      "equals": 0
    },
    {
      "action": "click",
      "target": "css=#your-roles button[data-govmem-handover][data-office=\"${fixtures.office.id}\"][data-role=\"primary_approver\"]"
    },
    {
      "action": "check",
      "target": "css=#govmem-handover fieldset[data-govmem-office=\"${fixtures.office.id}\"]:not([disabled]) input[name=\"assigned_user_id\"][value=\"${actors.${params.to}.id}\"]"
    },
    {
      "action": "submitForm",
      "target": "css=#govmem-handover button[type=\"submit\"]"
    },
    {
      "action": "assert",
      "target": "css=#your-roles form[action$=\"/cancel\"]",
      "test": "count",
      "equals": 1
    },
    {
      "action": "capture",
      "target": "css=#your-roles form[action$=\"/cancel\"]",
      "attribute": "action",
      "pattern": "/handshake/(\\d+)/cancel",
      "as": "${params.as}"
    },
    {
      "action": "ledger",
      "kind": "role_handshake",
      "id": "${captured.${params.as}}",
      "effect": "Role handover proposed through UI; restored by the paired return handover",
      "cleanup": "retained"
    }
  ]
}
