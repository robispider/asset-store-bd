{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GovStore Live Flow Schema",
  "type": "object",
  "required": ["schemaVersion", "id", "steps"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+$"
    },
    "title": {
      "type": "string"
    },
    "params": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": { "type": "string" },
          "required": { "type": "boolean", "default": false },
          "default": {}
        }
      }
    },
    "steps": {
      "type": "array",
      "items": { "type": "object" }
    }
  }
}
