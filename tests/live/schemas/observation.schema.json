{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GovStore Live Observation Schema",
  "type": "object",
  "required": ["schemaVersion", "contracts"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "contracts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["description", "parameters", "outputFields"],
        "properties": {
          "description": { "type": "string" },
          "parameters": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "outputFields": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
