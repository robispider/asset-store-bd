{
  "schemaVersion": 1,
  "id": "asset-tagging.access-boundaries",
  "title": "Each role reaches only its own tagging screens: storekeeper and approver get the GRN hub and tag lookup but no settings, office admin gets office tag settings only, company admin gets the company code lists only, and none of them reaches the enablement console or the Rules studio",
  "features": ["asset-tagging.access", "rules-studio.access"],
  "tags": ["seeded", "readonly", "asset-tagging", "authorization"],
  "execution": { "capability": "observe", "language": "en-US", "timeoutMs": 120000, "accessMode": "any" },
  "fixtures": {
    "office": { "requirements": { "operational": true, "ledgerOpen": true } },
    "actors": {
      "storekeeper": { "role": "storekeeper", "capabilities": { "allOf": ["storeops.documents.post", "asset-tags.lookup"], "noneOf": ["asset-tags.office.configure", "asset-tags.company.codelists", "asset-tags.scope.enable"] } },
      "approver": { "role": "primary_approver", "capabilities": { "allOf": ["storeops.documents.view"], "noneOf": ["storeops.documents.draft", "asset-tags.office.configure", "asset-tags.scope.enable"] } },
      "officeAdmin": { "role": "office_admin", "capabilities": { "allOf": ["asset-tags.office.configure"], "noneOf": ["asset-tags.company.codelists", "asset-tags.scope.enable"] } },
      "companyAdmin": { "role": "company_admin", "activeMembership": false, "capabilities": { "allOf": ["asset-tags.company.codelists"], "noneOf": ["asset-tags.office.configure", "asset-tags.scope.enable"] } }
    }
  },
  "steps": [
    { "use": "auth.login", "with": { "actor": "storekeeper" } },
    { "action": "probe", "path": "/gov-store/operations/hub", "expectStatus": [200] },
    { "action": "probe", "path": "/gov-store/asset-tags/lookup", "expectStatus": [200] },
    { "action": "probe", "path": "/gov-store/asset-tags/settings", "expectStatus": [403], "note": "asset-tags.office.configure enforces in shadow mode too" },
    { "action": "probe", "path": "/gov-store/asset-tags/codes", "expectStatus": [403] },
    { "action": "probe", "path": "/gov-store/asset-tags/enablement", "expectStatus": [403] },
    { "action": "probe", "path": "/gov-store/operations/settings/product-rules", "expectStatus": [403], "note": "Rules studio is national (superuser) only" },
    { "action": "probe", "path": "/admin/catalog/finance", "expectStatus": [403] },

    { "use": "auth.login", "with": { "actor": "approver" } },
    { "action": "probe", "path": "/gov-store/operations/hub", "expectStatus": [200] },
    { "action": "probe", "path": "/gov-store/asset-tags/lookup", "expectStatus": [200] },
    { "action": "probe", "path": "/gov-store/asset-tags/settings", "expectStatus": [403] },
    { "action": "probe", "path": "/gov-store/asset-tags/codes", "expectStatus": [403] },
    { "action": "probe", "path": "/gov-store/asset-tags/enablement", "expectStatus": [403] },
    { "action": "probe", "path": "/gov-store/operations/settings/product-rules", "expectStatus": [403] },

    { "use": "auth.login", "with": { "actor": "officeAdmin" } },
    { "action": "probe", "path": "/gov-store/asset-tags/settings", "expectStatus": [200] },
    { "action": "probe", "path": "/gov-store/asset-tags/codes", "expectStatus": [403] },
    { "action": "probe", "path": "/gov-store/asset-tags/enablement", "expectStatus": [403] },
    { "action": "probe", "path": "/gov-store/operations/settings/product-rules", "expectStatus": [403] },
    { "action": "goto", "route": "asset-tags.settings" },
    { "action": "assert", "target": "tagging.page", "test": "count", "equals": 1 },
    { "action": "assert", "target": "tagging.settingsTabs", "test": "count", "equals": 0, "note": "One tab only, so no tab bar: the company code-list tab is offered only to company administrators" },
    { "action": "assert", "target": "css=.at-page a[href$='/asset-tags/codes']", "test": "count", "equals": 0 },
    { "action": "assert", "target": "tagging.readinessItems", "test": "count", "equals": 6, "note": "Gates G1-G6 are listed for the office" },

    { "use": "auth.login", "with": { "actor": "companyAdmin" } },
    { "action": "probe", "path": "/gov-store/asset-tags/codes", "expectStatus": [200] },
    { "action": "probe", "path": "/gov-store/asset-tags/settings", "expectStatus": [403] },
    { "action": "probe", "path": "/gov-store/asset-tags/enablement", "expectStatus": [403] },
    { "action": "probe", "path": "/gov-store/operations/settings/product-rules", "expectStatus": [403] }
  ],
  "cleanup": { "policy": "no-business-records-created" }
}
