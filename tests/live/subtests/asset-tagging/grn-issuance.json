{
  "schemaVersion": 1,
  "id": "asset-tagging.grn-issuance",
  "title": "The storekeeper receives a purchase GRN with three asset lines: 2 desktops get Govt. Tags from the product type's national Finance Code, 1 scanner gets a Govt. Tag from a Finance Code chosen on the line, 1 printer keeps a standard tag on purpose; the posting modal and the posted box show 3 Govt. + 1 standard, every tag matches the 18-digit rule built from the challan date and office codes, the CSV lists them, lookup decodes a tag for the storekeeper and the super admin, the approver reads the posted GRN, and another office sees nothing",
  "features": ["asset-tagging.grn", "asset-tagging.lookup", "asset-tagging.export", "storeops.grn"],
  "tags": ["seeded", "write", "asset-tagging", "multi-actor", "multi-office"],
  "execution": { "capability": "write-fixtures", "language": "en-US", "timeoutMs": 300000, "accessMode": "any" },
  "fixtures": {
    "office": { "requirements": { "operational": true, "ledgerOpen": true } },
    "actors": {
      "storekeeper": { "role": "storekeeper", "capabilities": { "allOf": ["storeops.documents.draft", "storeops.documents.post"] } },
      "approver": { "role": "primary_approver", "capabilities": { "allOf": ["storeops.documents.view"], "noneOf": ["storeops.documents.draft"] } },
      "siblingKeeper": { "role": "storekeeper", "office": "sibling", "capabilities": { "allOf": ["storeops.documents.view"] } },
      "superuser": { "role": "superuser", "allowSuperuser": true, "activeMembership": false, "capabilities": { "allOf": ["asset-tags.lookup"] } }
    },
    "records": {
      "sibling": { "kind": "office", "sameCompany": true, "ledgerOpen": true },
      "desktop": { "kind": "assetModel", "categoryContains": "Desktop Computers" },
      "scanner": { "kind": "assetModel", "categoryContains": "Scanners" },
      "printer": { "kind": "assetModel", "categoryContains": "Printers" },
      "scannerCode": { "kind": "financeItem", "itemName": "Scanner" }
    }
  },
  "data": {
    "nativePrefix": "GS-",
    "challanNo": { "generate": "markedText", "prefix": "LIVE-CH", "length": 5 },
    "challanDate": { "generate": "date", "offsetDays": -5 },
    "challanMMYY": { "generate": "date", "offsetDays": -5, "format": "MMYY" },
    "missingTag": { "generate": "markedText", "prefix": "NOPE", "length": 6 }
  },
  "steps": [
    { "action": "observe", "check": "asset-tags.readiness", "args": { "officeId": "${fixtures.office.id}" }, "as": "ready" },
    { "action": "compare", "actual": "${observed.ready.enabled}", "equals": true, "note": "Precondition: the office is enabled (asset-tagging.enablement)" },
    { "action": "observe", "check": "asset-tags.default", "args": { "categoryId": "${fixtures.desktop.category_id}" }, "as": "desktopDefault" },
    { "action": "observe", "check": "asset-tags.default", "args": { "categoryId": "${fixtures.scanner.category_id}" }, "as": "scannerDefault" },
    { "action": "observe", "check": "asset-tags.default", "args": { "categoryId": "${fixtures.printer.category_id}" }, "as": "printerDefault" },
    { "action": "compare", "actual": "${observed.scannerDefault.gov_code}", "equals": null, "note": "Precondition: scanners and printers have no product-type Finance Code" },
    { "action": "compare", "actual": "${observed.printerDefault.gov_code}", "equals": null },

    { "use": "auth.login", "with": { "actor": "storekeeper" } },
    { "action": "goto", "route": "storeops.hub", "query": { "start": "receipt" } },
    { "action": "wait", "target": "storeops.hubStartDialog", "state": "visible" },
    { "action": "check", "target": "storeops.hubStartReceipt" },
    { "action": "submitForm", "target": "storeops.hubStartSubmit" },
    { "action": "assert", "test": "url", "contains": "/gov-store/operations/documents/receipt/" },
    { "action": "capture", "url": true, "pattern": "/documents/receipt/([0-9a-f-]{36})", "as": "docId" },
    { "action": "ledger", "kind": "grn", "id": "${captured.docId}", "effect": "Purchase GRN drafted (posted below; posted GRNs and issued tags are permanent)", "cleanup": "retained" },

    { "action": "select", "target": "storeops.purchaseType", "value": "Purchase" },
    { "action": "capture", "target": "css=#supplier_id option:not([value='']) >> nth=0", "attribute": "value", "as": "supplierId" },
    { "action": "select", "target": "css=#supplier_id", "value": "${captured.supplierId}", "note": "Purchases need an active supplier (store-operations rule)" },
    { "action": "fill", "target": "storeops.challanNumber", "value": "${data.challanNo}" },
    { "action": "fill", "target": "storeops.challanDate", "value": "${data.challanDate}" },

    { "action": "select2", "target": "storeops.row0Item", "search": "${fixtures.desktop.name}", "option": "${fixtures.desktop.name}" },
    { "action": "fill", "target": "storeops.row0Qty", "value": "2" },
    { "action": "fill", "target": "storeops.row0Cost", "value": "45000" },
    { "action": "wait", "target": "tagging.panel0Govt", "state": "visible", "note": "After the autosave the panel re-renders with the saved challan date" },
    { "action": "assert", "target": "tagging.panel0FromType", "test": "visible" },
    { "action": "assert", "target": "tagging.panel0Code", "test": "text", "equals": "${observed.desktopDefault.gov_code}" },
    { "action": "assert", "target": "tagging.panel0Owner", "test": "visible", "note": "The panel names who owns the Finance default" },
    { "action": "assert", "target": "tagging.panel0Segments", "test": "count", "equals": 7 },
    { "action": "assert", "target": "css=tr[data-parent-index='0'] .at-preview .gs-seg:nth-child(4) .gs-seg__v", "test": "text", "equals": "${data.challanMMYY}", "note": "MMYY comes from the Supplier Challan date" },
    { "action": "assert", "target": "css=tr[data-parent-index='0'] .at-preview .gs-seg:nth-child(5) .gs-seg__v", "test": "text", "equals": "${observed.ready.locationCode}" },
    { "action": "assert", "target": "css=tr[data-parent-index='0'] .at-preview .gs-seg:nth-child(6) .gs-seg__v", "test": "text", "equals": "${observed.ready.defaultDivision}" },
    { "action": "assert", "target": "tagging.panel0Pending", "test": "count", "equals": 1, "note": "The sequence is allocated only at posting" },
    { "action": "assert", "target": "tagging.panel0Division", "test": "value", "equals": "${observed.ready.defaultDivision}", "note": "Offices with several divisions get a per-line choice, preset to the default" },

    { "action": "click", "target": "storeops.addRow" },
    { "action": "select2", "target": "storeops.row1Item", "search": "${fixtures.scanner.name}", "option": "${fixtures.scanner.name}" },
    { "action": "fill", "target": "storeops.row1Qty", "value": "1" },
    { "action": "fill", "target": "storeops.row1Cost", "value": "70000" },
    { "action": "wait", "target": "tagging.panel1Warning", "state": "visible", "note": "No Finance Code: a warning with a fix, not a block" },
    { "action": "select2", "target": "tagging.panel1Code", "search": "${fixtures.scannerCode.gov_code}", "option": "${fixtures.scannerCode.gov_code}" },
    { "action": "wait", "target": "tagging.panel1Govt", "state": "visible" },
    { "action": "assert", "target": "tagging.panel1FromLine", "test": "visible" },

    { "action": "click", "target": "storeops.addRow" },
    { "action": "select2", "target": "storeops.row2Item", "search": "${fixtures.printer.name}", "option": "${fixtures.printer.name}" },
    { "action": "fill", "target": "storeops.row2Qty", "value": "1" },
    { "action": "fill", "target": "storeops.row2Cost", "value": "20000" },
    { "action": "wait", "target": "tagging.panel2Warning", "state": "visible" },
    { "action": "click", "target": "tagging.panel2KeepStandard" },
    { "action": "wait", "target": "tagging.panel2StandardChosen", "state": "visible" },
    { "action": "assert", "target": "tagging.panel2Standard", "test": "visible" },

    { "action": "wait", "target": "css=#triggerPostBtn:not([disabled])", "state": "attached" },
    { "action": "assert", "target": "storeops.checklistPassing", "test": "count", "equals": 5, "note": "Supplier, reference and one row per line pass (guards the zero below)" },
    { "action": "assert", "target": "storeops.checklistFailing", "test": "count", "equals": 0 },
    { "action": "assert", "target": "storeops.checklistWarnings", "test": "count", "equals": 0, "note": "The printer's missing Finance Code was dismissed on purpose" },
    { "action": "click", "target": "storeops.post" },
    { "action": "wait", "target": "storeops.previewTags", "state": "visible" },
    { "action": "assert", "target": "storeops.previewTags", "test": "text", "matches": "3\\D+1", "note": "Tags: 3 Govt. Tags · 1 standard tag — permanent" },
    { "action": "assert", "target": "storeops.previewQty", "test": "number", "equals": 4 },
    { "action": "submitForm", "target": "storeops.confirmPost" },
    { "action": "wait", "target": "tagging.issuedBox", "state": "visible" },

    { "action": "assert", "target": "tagging.issuedItems", "test": "count", "equals": 4 },
    { "action": "assert", "target": "tagging.issuedGovt", "test": "count", "equals": 3 },
    { "action": "assert", "target": "tagging.issuedStandard", "test": "count", "equals": 1 },
    { "action": "assert", "target": "tagging.issuedSummary", "test": "text", "matches": "3\\D+1" },
    { "action": "assert", "target": "tagging.issuedPrint", "test": "visible" },
    { "action": "capture", "target": "tagging.issuedPrint", "attribute": "formaction", "as": "printAction" },
    { "action": "compare", "actual": "${captured.printAction}", "contains": "/hardware/bulkedit", "note": "Print labels submits to the native label print, not the posting form it sits in" },

    { "action": "observe", "check": "asset-tags.document", "args": { "id": "${captured.docId}", "modelId": "${fixtures.desktop.id}" }, "as": "desk" },
    { "action": "compare", "actual": "${observed.desk.status}", "equals": "POSTED" },
    { "action": "compare", "actual": "${observed.desk.posted_by}", "equals": "${actors.storekeeper.id}" },
    { "action": "compare", "actual": "${observed.desk.govt}", "equals": 3 },
    { "action": "compare", "actual": "${observed.desk.standard}", "equals": 1 },
    { "action": "compare", "actual": "${observed.desk.entered}", "equals": 0 },
    { "action": "compare", "actual": "${observed.desk.allAssetTagsMatch}", "equals": true, "note": "Each asset carries exactly its registered tag" },
    { "action": "compare", "actual": "${observed.desk.challanDate}", "equals": "${data.challanDate}" },
    { "action": "compare", "actual": "${observed.desk.modelTags}", "matches": "^(${observed.desktopDefault.gov_code}${data.challanMMYY}${observed.ready.locationCode}${observed.ready.defaultDivision}\\d{4},?){2}$", "note": "GG SS II MMYY LL DD NNNN: product-type code, challan month, office location, default division" },
    { "action": "compare", "actual": "${observed.desk.modelFinanceSources}", "equals": "product_type" },
    { "action": "compare", "actual": "${observed.desk.modelPurchaseDates}", "equals": "${data.challanDate}", "note": "The asset's purchase date is the acquisition date" },
    { "action": "compare", "actual": "${observed.desk.modelOffices}", "equals": "${fixtures.office.id}" },

    { "action": "observe", "check": "asset-tags.document", "args": { "id": "${captured.docId}", "modelId": "${fixtures.scanner.id}" }, "as": "scan" },
    { "action": "compare", "actual": "${observed.scan.modelTags}", "matches": "^${fixtures.scannerCode.gov_code}${data.challanMMYY}${observed.ready.locationCode}${observed.ready.defaultDivision}\\d{4}$" },
    { "action": "compare", "actual": "${observed.scan.modelFinanceSources}", "equals": "line_choice" },

    { "action": "observe", "check": "asset-tags.document", "args": { "id": "${captured.docId}", "modelId": "${fixtures.printer.id}" }, "as": "prn" },
    { "action": "compare", "actual": "${observed.prn.modelFormats}", "equals": "native-v1" },
    { "action": "compare", "actual": "${observed.prn.modelTags}", "matches": "^${data.nativePrefix}\\d+$", "note": "Standard tags use the native prefix and sequence" },
    { "action": "compare", "actual": "${observed.prn.modelStandardReasons}", "equals": "chosen" },
    { "action": "compare", "actual": "${observed.prn.modelPurchaseDates}", "equals": "", "note": "A standard tag carries no acquisition date" },

    { "action": "capture", "target": "tagging.issuedFirstGovtTag", "as": "govtTag" },
    { "action": "compare", "actual": "${captured.govtTag}", "matches": "^\\d{18}$" },
    { "action": "observe", "check": "asset-tags.tag", "args": { "tag": "${captured.govtTag}" }, "as": "tag" },
    { "action": "compare", "actual": "${observed.tag.assetsWithTag}", "equals": 1 },
    { "action": "compare", "actual": "${observed.tag.location_id}", "equals": "${fixtures.office.id}" },

    { "action": "download", "target": "tagging.issuedCsv", "as": "csv" },
    { "action": "compare", "actual": "${captured.csv.rowCount}", "equals": 4 },
    { "action": "compare", "actual": "${captured.csv.text}", "contains": "${captured.govtTag}" },

    { "action": "goto", "route": "asset-tags.lookup", "query": { "tag": "${captured.govtTag}" } },
    { "action": "assert", "target": "tagging.lookupGovtBadge", "test": "visible", "note": "The storekeeper who received the asset can decode its tag" },
    { "action": "assert", "target": "tagging.lookupSegments", "test": "count", "equals": 7 },
    { "action": "goto", "route": "asset-tags.lookup", "query": { "tag": "${data.missingTag}" } },
    { "action": "assert", "target": "tagging.lookupNone", "test": "visible" },

    { "use": "auth.login", "with": { "actor": "approver" } },
    { "action": "goto", "route": "storeops.workspace", "params": { "type": "receipt", "id": "${captured.docId}" } },
    { "action": "assert", "target": "tagging.issuedItems", "test": "count", "equals": 4, "note": "The approver reads the posted GRN and its tags" },
    { "action": "probe", "path": "/gov-store/asset-tags/documents/${captured.docId}/issued.csv", "expectStatus": [200] },

    { "use": "auth.login", "with": { "actor": "siblingKeeper" } },
    { "action": "goto", "route": "asset-tags.lookup", "query": { "tag": "${captured.govtTag}" } },
    { "action": "assert", "target": "tagging.lookupNone", "test": "visible", "note": "A tag never grants access: another office gets the neutral answer" },
    { "action": "probe", "path": "/gov-store/operations/documents/receipt/${captured.docId}", "expectStatus": [403, 404] },
    { "action": "probe", "path": "/gov-store/asset-tags/documents/${captured.docId}/issued.csv", "expectStatus": [403, 404] },

    { "use": "auth.login", "with": { "actor": "superuser" } },
    { "action": "goto", "route": "asset-tags.lookup", "query": { "tag": "${captured.govtTag}" } },
    { "action": "assert", "target": "tagging.lookupGovtBadge", "test": "visible" },
    { "action": "assert", "target": "tagging.lookupSegments", "test": "count", "equals": 7 }
  ],
  "cleanup": { "policy": "retained-with-report" }
}
