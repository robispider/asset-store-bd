{
  "schemaVersion": 1,
  "id": "committee.foreign-committee-boundary",
  "title": "An office administrator cannot open a committee of another office or company by guessing its id",
  "features": ["committee.authorization"],
  "tags": ["seeded", "readonly", "security"],
  "execution": {"capability": "observe", "language": "en-US", "timeoutMs": 90000},
  "fixtures": {
    "office": {"requirements": {"operational": true}},
    "actors": {
      "registrar": {
        "capabilities": {"allOf": ["committee.manage", "committee.view"], "noneOf": ["committee.types.manage"]},
        "office": "office",
        "activeMembership": true
      }
    }
  },
  "steps": [
    {"action": "observe", "check": "committee.visibility", "args": {"officeId": "${fixtures.office.id}", "companyId": "${fixtures.office.company_id}"}, "as": "visible"},
    {"use": "auth.login", "with": {"actor": "registrar"}},
    {"action": "probe", "path": "/gov-store/committees/${observed.visible.foreignId}", "expectStatus": [403, 404], "as": "detail"},
    {"action": "probe", "path": "/gov-store/committees/${observed.visible.foreignId}/history", "expectStatus": [403, 404], "as": "history"},
    {"action": "probe", "path": "/gov-store/committees/${observed.visible.foreignId}/print", "expectStatus": [403, 404], "as": "print"},
    {"action": "probe", "path": "/gov-store/committees/api/${observed.visible.foreignId}/roster", "expectStatus": [403, 404], "as": "roster"},
    {"action": "probe", "path": "/gov-store/committees/api/${observed.visible.foreignId}/composition", "expectStatus": [403, 404], "as": "composition"},
    {"action": "goto", "route": "committee.registry", "query": {"q": "${observed.visible.foreignNumber}"}},
    {"action": "assert", "target": "committee.registryRows", "test": "count", "equals": 0, "note": "A committee outside the boundary must not be found by its number either."},
    {"action": "observe", "check": "committee.visibility", "args": {"officeId": "${fixtures.office.id}", "companyId": "${fixtures.office.company_id}"}, "as": "visibleAfter"},
    {"action": "compare", "actual": "${observed.visibleAfter.count}", "equals": "${observed.visible.count}"}
  ],
  "cleanup": {"policy": "no-business-records-created"}
}
