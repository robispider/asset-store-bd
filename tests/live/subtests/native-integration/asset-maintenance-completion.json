{
  "schemaVersion": 1,
  "id": "native-integration.asset-maintenance-completion",
  "title": "Request, approve, issue, acknowledge and return an asset, then record and complete its native maintenance",
  "evidenceLevel": "connected",
  "features": [
    "storeops.grn",
    "requests.submit-approve-fulfill",
    "user-story.us-19"
  ],
  "tags": [
    "functional",
    "multi-actor",
    "write",
    "connected"
  ],
  "execution": {
    "capability": "write-fixtures",
    "language": "en-US",
    "timeoutMs": 480000,
    "accessMode": "any"
  },
  "fixtures": {
    "office": {
      "requirements": {
        "operational": true,
        "ledgerOpen": true
      }
    },
    "actors": {
      "storekeeper": {
        "role": "storekeeper",
        "capabilities": {
          "allOf": [
            "storeops.documents.draft",
            "storeops.documents.post",
            "requests.fulfill"
          ]
        }
      },
      "employee": {
        "capabilities": {
          "allOf": [
            "requests.submit"
          ],
          "noneOf": [
            "requests.approve"
          ]
        },
        "emptyBasket": true
      },
      "approver": {
        "role": "primary_approver",
        "capabilities": {
          "allOf": [
            "requests.approve.primary"
          ]
        }
      },
      "finalApprover": {
        "role": "final_approver",
        "capabilities": {
          "allOf": [
            "requests.approve.final"
          ]
        }
      }
    },
    "records": {
      "item": {
        "kind": "assetModel",
        "categoryContains": "Desktop Computers",
        "policy": "PRIMARY_AND_FINAL",
        "requestQuantity": 1
      }
    }
  },
  "data": {
    "qty": 1,
    "receiptQty": 1,
    "purpose": {
      "generate": "markedText",
      "prefix": "LIVE-E2E",
      "length": 6
    },
    "serial": {
      "generate": "markedText",
      "prefix": "LIVE-SN",
      "length": 8
    },
    "receiptDate": {
      "generate": "date",
      "offsetDays": 0
    },
    "maintenanceName": {
      "generate": "markedText",
      "prefix": "LIVE-MAINT",
      "length": 7
    }
  },
  "preconditions": [],
  "steps": [
    {
      "use": "auth.login",
      "with": {
        "actor": "employee"
      }
    },
    {
      "action": "goto",
      "route": "gov.requests.catalog",
      "query": {
        "q": "${fixtures.item.name}"
      }
    },
    {
      "action": "click",
      "target": "catalog.itemAdd",
      "waitForResponse": "basket/add"
    },
    {
      "action": "fill",
      "target": "catalog.itemQty",
      "value": "${data.qty}"
    },
    {
      "action": "waitInspect",
      "check": "ui.basket",
      "args": {
        "name": "${fixtures.item.name}"
      },
      "path": "quantity",
      "equals": "${data.qty}",
      "timeoutMs": 15000
    },
    {
      "action": "ledger",
      "kind": "task_basket_line",
      "id": "${actors.employee.id}:${fixtures.item.id}",
      "effect": "Run-owned basket line; empty basket verified during fixture resolution",
      "cleanup": "retained"
    },
    {
      "action": "goto",
      "route": "gov.requests.basket"
    },
    {
      "action": "assert",
      "target": "requests.basketLines",
      "test": "count",
      "equals": 1
    },
    {
      "action": "assert",
      "target": "requests.basketQty",
      "test": "value",
      "equals": "${data.qty}"
    },
    {
      "action": "click",
      "target": "requests.basketToDetails"
    },
    {
      "action": "fill",
      "target": "requests.basketPurpose",
      "value": "${data.purpose}"
    },
    {
      "action": "fill",
      "target": "requests.basketJustification",
      "value": "Automated live journey justification for ${data.purpose}"
    },
    {
      "action": "click",
      "target": "requests.basketContinue"
    },
    {
      "action": "assert",
      "target": "requests.basketSubmit",
      "test": "visible"
    },
    {
      "action": "check",
      "target": "requests.basketDeclare"
    },
    {
      "action": "submitForm",
      "target": "requests.basketSubmit"
    },
    {
      "action": "assert",
      "test": "url",
      "contains": "/gov-requests/sent/"
    },
    {
      "action": "capture",
      "target": "requests.sentNumberFirst",
      "as": "requestNumber"
    },
    {
      "action": "capture",
      "target": "requests.sentNumberFirst",
      "attribute": "href",
      "pattern": "/my-requests/(\\d+)",
      "as": "requestId"
    },
    {
      "action": "ledger",
      "kind": "custom_service_request",
      "id": "${captured.requestNumber}",
      "effect": "Request created by the complete receipt, approval, fulfillment and acknowledgement journey",
      "cleanup": "retained"
    },
    {
      "use": "auth.login",
      "with": {
        "actor": "approver"
      }
    },
    {
      "action": "goto",
      "route": "gov.requests.admin.index",
      "query": {
        "q": "${captured.requestNumber}"
      }
    },
    {
      "action": "click",
      "target": "requests.approverRowOpen"
    },
    {
      "action": "wait",
      "target": "requests.decisionAsAsked",
      "state": "visible"
    },
    {
      "action": "click",
      "target": "requests.decisionSubmit"
    },
    {
      "action": "waitInspect",
      "check": "ui.request",
      "args": {
        "view": "admin",
        "id": "${captured.requestId}"
      },
      "path": "status",
      "equals": "request_pending_final",
      "as": "primary"
    },
    {
      "action": "compare",
      "actual": "${observed.primary.number}",
      "equals": "${captured.requestNumber}"
    },
    {
      "use": "auth.login",
      "with": {
        "actor": "finalApprover"
      }
    },
    {
      "action": "goto",
      "route": "gov.requests.admin.index",
      "query": {
        "q": "${captured.requestNumber}",
        "tab": "final"
      }
    },
    {
      "action": "click",
      "target": "requests.approverRowOpen"
    },
    {
      "action": "wait",
      "target": "requests.decisionAsAsked",
      "state": "visible"
    },
    {
      "action": "click",
      "target": "requests.decisionSubmit"
    },
    {
      "action": "waitInspect",
      "check": "ui.request",
      "args": {
        "view": "admin",
        "id": "${captured.requestId}"
      },
      "path": "status",
      "equals": "request_approved",
      "as": "approved"
    },
    {
      "action": "compare",
      "actual": "${observed.approved.number}",
      "equals": "${captured.requestNumber}"
    },
    {
      "action": "compare",
      "actual": "${observed.approved.lines.0.approved}",
      "equals": "${data.qty}"
    },
    {
      "use": "auth.login",
      "with": {
        "actor": "storekeeper"
      }
    },
    {
      "action": "goto",
      "route": "gov.requests.fulfillment.index",
      "query": {
        "q": "${captured.requestNumber}"
      }
    },
    {
      "action": "click",
      "target": "requests.fulfillmentRowOpen"
    },
    {
      "action": "wait",
      "target": "requests.issueSubmit",
      "state": "visible"
    },
    {
      "action": "capture",
      "target": "css=[data-cr-serials] input[type=\"checkbox\"]:enabled >> nth=0",
      "attribute": "value",
      "as": "assetId"
    },
    {
      "action": "capture",
      "target": "css=[data-cr-serials] li:has(input[value=\"${captured.assetId}\"]) strong",
      "as": "assetTag"
    },
    {
      "action": "inspect",
      "check": "ui.asset",
      "args": {
        "id": "${captured.assetId}"
      },
      "as": "returnAsset"
    },
    {
      "action": "check",
      "target": "css=[data-cr-serials] input[value=\"${captured.assetId}\"]"
    },
    {
      "action": "submitForm",
      "target": "requests.issueSubmit"
    },
    {
      "action": "waitInspect",
      "check": "ui.request",
      "args": {
        "view": "fulfillment-register",
        "id": "${captured.requestId}"
      },
      "path": "status",
      "equals": "request_issued",
      "as": "issued"
    },
    {
      "action": "compare",
      "actual": "${observed.issued.number}",
      "equals": "${captured.requestNumber}"
    },
    {
      "action": "compare",
      "actual": "${observed.issued.lines.0.issued}",
      "equals": "${data.qty}"
    },
    {
      "action": "compare",
      "actual": "${observed.issued.history}",
      "contains": "${actors.storekeeper.display_name}"
    },
    {
      "action": "actor",
      "name": "employee"
    },
    {
      "action": "goto",
      "route": "gov.requests.user.index",
      "query": {
        "tab": "needs_you"
      }
    },
    {
      "action": "click",
      "target": "requests.requestShow"
    },
    {
      "action": "wait",
      "target": "requests.acknowledge",
      "state": "visible"
    },
    {
      "action": "assert",
      "target": "requests.requestLineIssued",
      "test": "number",
      "equals": "${data.qty}"
    },
    {
      "action": "submitForm",
      "target": "requests.acknowledge"
    },
    {
      "action": "reload"
    },
    {
      "action": "waitInspect",
      "check": "ui.request",
      "args": {
        "view": "my-requests",
        "id": "${captured.requestId}"
      },
      "path": "status",
      "equals": "request_received",
      "as": "received"
    },
    {
      "action": "compare",
      "actual": "${observed.received.number}",
      "equals": "${captured.requestNumber}"
    },
    {
      "action": "compare",
      "actual": "${observed.received.history}",
      "contains": "${actors.employee.display_name}"
    },
    {
      "action": "assert",
      "target": "css=[data-cr-request][data-status-key=\"request_received\"]",
      "test": "visible"
    },
    {
      "action": "assert",
      "target": "requests.acknowledge",
      "test": "count",
      "equals": 0
    },
    {
      "action": "actor",
      "name": "storekeeper"
    },
    {
      "action": "goto",
      "url": "/hardware/${captured.assetId}"
    },
    {
      "action": "assert",
      "target": "css=.content",
      "test": "text",
      "contains": "${captured.assetTag}"
    },
    {
      "action": "assert",
      "target": "css=.well >> nth=0",
      "test": "text",
      "contains": "${actors.employee.display_name}"
    },
    {
      "action": "actor",
      "name": "employee"
    },
    {
      "action": "goto",
      "url": "/account/view-assets"
    },
    {
      "action": "assert",
      "target": "css=table[data-id-table=\"userAssets\"] tbody tr:has-text(\"${captured.assetTag}\")",
      "test": "text",
      "contains": "${captured.assetTag}"
    },
    {
      "action": "actor",
      "name": "storekeeper"
    },
    {
      "action": "goto",
      "url": "/hardware/${captured.assetId}"
    },
    {
      "action": "click",
      "target": "css=a[href*=\"/hardware/${captured.assetId}/checkin\"] >> nth=0"
    },
    {
      "action": "select",
      "target": "css=select[name=\"status_id\"]",
      "value": "${observed.returnAsset.statusId}"
    },
    {
      "action": "check",
      "target": "css=#set_requestable"
    },
    {
      "action": "select2",
      "target": "css=select[name=\"location_id\"]",
      "search": "${fixtures.office.name}",
      "option": "${fixtures.office.name}"
    },
    {
      "action": "fill",
      "target": "css=textarea[name=\"note\"]",
      "value": "${data.purpose}"
    },
    {
      "action": "submitForm",
      "target": "css=#submit_button"
    },
    {
      "action": "goto",
      "url": "/hardware/${captured.assetId}"
    },
    {
      "action": "assert",
      "target": "css=.well >> nth=0",
      "test": "text",
      "contains": "Ready"
    },
    {
      "action": "assert",
      "target": "css=.well .text-green >> nth=0",
      "test": "visible"
    },
    {
      "action": "actor",
      "name": "employee"
    },
    {
      "action": "goto",
      "url": "/account/view-assets"
    },
    {
      "action": "assert",
      "target": "css=table[data-id-table=\"userAssets\"] tbody tr:has-text(\"${captured.assetTag}\")",
      "test": "count",
      "equals": 0
    },
    {
      "action": "ledger",
      "kind": "native_asset_checkin",
      "id": "${captured.assetId}",
      "effect": "Run-issued fictional asset returned to stock through native check-in; audit retained",
      "cleanup": "retained"
    },
    {
      "action": "actor",
      "name": "storekeeper"
    },
    {
      "action": "goto",
      "url": "/maintenances/create"
    },
    {
      "action": "fill",
      "target": "css=input[name=name]",
      "value": "${data.maintenanceName}"
    },
    {
      "action": "select2",
      "target": "css=select[name=\"selected_assets[]\"]",
      "search": "${captured.assetTag}",
      "option": "${captured.assetTag}"
    },
    {
      "action": "select2",
      "target": "css=#maintenance_type_id",
      "selection": "first",
      "as": "maintenanceType",
      "search": ""
    },
    {
      "action": "click",
      "target": "css=input[name=start_date]"
    },
    {
      "action": "click",
      "target": "css=.datepicker-days:visible tfoot .today:visible"
    },
    {
      "action": "assert",
      "target": "css=input[name=start_date]",
      "test": "value",
      "equals": "${data.receiptDate}"
    },
    {
      "action": "fill",
      "target": "css=textarea[name=notes]",
      "value": "${data.purpose} - fictional UI maintenance exercise"
    },
    {
      "action": "fill",
      "target": "css=input[name=cost]",
      "value": "0"
    },
    {
      "action": "submitForm",
      "target": "css=form[action$=\"/maintenances\"] button[type=submit]",
      "rejectFlashErrors": true
    },
    {
      "action": "ledger",
      "kind": "native_maintenance_creation",
      "id": "${data.maintenanceName}",
      "effect": "Native maintenance form submitted successfully; exact identifier and completion require subsequent UI readback",
      "cleanup": "retained"
    },
    {
      "action": "goto",
      "url": "/maintenances"
    },
    {
      "action": "fill",
      "target": "css=.fixed-table-toolbar .search input",
      "value": "${data.maintenanceName}"
    },
    {
      "action": "keyboard",
      "key": "Enter"
    },
    {
      "action": "wait",
      "target": "css=#ListingTable tbody tr:has-text(\"${data.maintenanceName}\")"
    },
    {
      "action": "capture",
      "target": "css=#ListingTable tbody tr:has-text(\"${data.maintenanceName}\") a[href$=\"/edit\"]",
      "attribute": "href",
      "pattern": "/maintenances/(\\d+)/edit",
      "as": "maintenanceId"
    },
    {
      "action": "click",
      "target": "css=.fixed-columns-right a[href$=\"/maintenances/${captured.maintenanceId}/edit\"]",
      "waitForNavigation": true
    },
    {
      "action": "assert",
      "target": "css=input[name=name]",
      "test": "value",
      "equals": "${data.maintenanceName}"
    },
    {
      "action": "goto",
      "url": "/maintenances/${captured.maintenanceId}"
    },
    {
      "action": "capture",
      "url": true,
      "as": "maintenanceUrl"
    },
    {
      "action": "assert",
      "target": "css=.content",
      "test": "text",
      "contains": "${captured.assetTag}"
    },
    {
      "action": "ledger",
      "kind": "native_maintenance",
      "id": "${captured.maintenanceId}",
      "effect": "Marked maintenance on the exact run-issued and returned fictional asset, completed through native UI",
      "cleanup": "retained"
    },
    {
      "action": "click",
      "target": "css=button[data-target=\"#completeMaintenanceModal\"]"
    },
    {
      "action": "fill",
      "target": "css=#completionNote",
      "value": "${data.purpose} - completed fictional staging exercise"
    },
    {
      "action": "submitForm",
      "target": "css=#completeMaintenanceModal button[type=submit]",
      "rejectFlashErrors": true
    },
    {
      "action": "goto",
      "url": "${captured.maintenanceUrl}"
    },
    {
      "action": "assert",
      "target": "css=.content",
      "test": "text",
      "contains": "${captured.assetTag}"
    },
    {
      "action": "assert",
      "target": "css=button[data-target=\"#completeMaintenanceModal\"]",
      "test": "count",
      "equals": 0
    },
    {
      "action": "assert",
      "target": "css=.content span.disabled[title]",
      "test": "text",
      "matches": "[Cc]omplete|সম্পন্ন"
    },
    {
      "action": "goto",
      "url": "/hardware/${captured.assetId}"
    },
    {
      "action": "click",
      "target": "css=a[href=\"#maintenances\"]"
    },
    {
      "action": "wait",
      "target": "css=#maintenancesListingTable tbody tr:has-text(\"${data.maintenanceName}\")"
    },
    {
      "action": "assert",
      "target": "css=#maintenancesListingTable tbody tr:has-text(\"${data.maintenanceName}\")",
      "test": "text",
      "contains": "${captured.assetTag}"
    }
  ],
  "cleanup": {
    "policy": "retained-with-report",
    "description": "Request, posted documents and audit retained; only the exact run-owned basket line is removed through the UI. Successful native check-in returns its fictional asset to stock.",
    "steps": [
      {
        "use": "auth.login",
        "with": {
          "actor": "employee"
        }
      },
      {
        "action": "inspect",
        "check": "ui.basket",
        "args": {
          "name": "${fixtures.item.name}"
        },
        "as": "cleanupBasket"
      },
      {
        "action": "goto",
        "route": "gov.requests.basket",
        "when": {
          "actual": "${observed.cleanupBasket.quantity}",
          "notEquals": 0
        }
      },
      {
        "action": "click",
        "target": "requests.basketRemove",
        "when": {
          "actual": "${observed.cleanupBasket.quantity}",
          "notEquals": 0
        },
        "waitForResponse": "basket/remove"
      },
      {
        "action": "waitInspect",
        "check": "ui.basket",
        "args": {
          "name": "${fixtures.item.name}"
        },
        "path": "quantity",
        "equals": 0
      },
      {
        "action": "ledger",
        "kind": "task_basket_line",
        "id": "${actors.employee.id}:${fixtures.item.id}",
        "effect": "Temporary basket line consumed or removed; zero quantity verified",
        "cleanup": "removed"
      }
    ]
  },
  "description": "Keeps the exact fictional asset through GovStore role handoffs, native check-in, maintenance creation, completion and asset maintenance history."
}
