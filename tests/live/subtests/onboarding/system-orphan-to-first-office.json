{
  "schemaVersion": 1,
  "id": "onboarding.system-orphan-to-first-office",
  "title": "Create a fictional unassigned account, assign its first office through onboarding, and verify the new person can request items",
  "description": "Exercises the supported super-administrator recovery of a newly created SYSTEM orphan. The new person uses a separate browser session before and after assignment. A password generated by the native form stays in memory and redacted; welcome email is disabled. Cleanup uses the supported native bulk editor to deactivate exactly the newly created account and preserves onboarding history.",
  "evidenceLevel": "connected",
  "features": [
    "user-story.us-04"
  ],
  "tags": [
    "functional",
    "write",
    "interface-only",
    "multi-actor"
  ],
  "execution": {
    "capability": "write-fixtures",
    "language": "en-US",
    "accessMode": "any",
    "timeoutMs": 300000
  },
  "fixtures": {
    "actors": {
      "admin": {
        "role": "superuser",
        "allowSuperuser": true,
        "activeMembership": false,
        "capabilities": {
          "allOf": [
            "onboarding.manage"
          ]
        }
      },
      "employee": {
        "capabilities": {
          "allOf": [
            "requests.submit"
          ],
          "noneOf": [
            "requests.approve"
          ]
        }
      }
    }
  },
  "data": {
    "marker": {
      "generate": "markedText",
      "prefix": "LIVE-ONBOARD",
      "length": 8
    }
  },
  "preconditions": [
    {
      "action": "capture",
      "value": 0,
      "as": "userId"
    }
  ],
  "steps": [
    {
      "use": "auth.login",
      "with": {
        "actor": "admin"
      }
    },
    {
      "action": "goto",
      "url": "/users/create"
    },
    {
      "action": "fill",
      "target": "css=#first_name",
      "value": "${data.marker}"
    },
    {
      "action": "fill",
      "target": "css=#last_name",
      "value": "Fictional acceptance"
    },
    {
      "action": "click",
      "target": "css=#username"
    },
    {
      "action": "fill",
      "target": "css=#username",
      "value": "${data.marker}"
    },
    {
      "action": "click",
      "target": "css=#genPassword",
      "sensitive": true
    },
    {
      "action": "capture",
      "target": "css=#password",
      "value": true,
      "as": "newPassword",
      "sensitive": true
    },
    {
      "action": "check",
      "target": "css=#activated"
    },
    {
      "action": "click",
      "target": "css=#email"
    },
    {
      "action": "fill",
      "target": "css=#email",
      "value": "${data.marker}@example.invalid"
    },
    {
      "action": "uncheck",
      "target": "css=#email_user_checkbox"
    },
    {
      "action": "select",
      "target": "css=select[name=locale]",
      "value": "en-US"
    },
    {
      "action": "select",
      "target": "css=select[name=redirect_option]",
      "value": "item"
    },
    {
      "action": "submitForm",
      "target": "css=#userForm button[type=submit]",
      "rejectFlashErrors": true,
      "sensitive": true
    },
    {
      "action": "capture",
      "url": true,
      "pattern": "/users/(\\d+)(?:$|[?#])",
      "as": "userId"
    },
    {
      "action": "ledger",
      "kind": "fictional_onboarding_user",
      "id": "${captured.userId}",
      "effect": "New ordinary unassigned account; cleanup must deactivate it through native UI",
      "cleanup": "retained"
    },
    {
      "action": "actor",
      "name": "newEmployee"
    },
    {
      "action": "goto",
      "url": "/login"
    },
    {
      "action": "fill",
      "target": "auth.username",
      "value": "${data.marker}",
      "sensitive": true
    },
    {
      "action": "fill",
      "target": "auth.password",
      "value": "${captured.newPassword}",
      "sensitive": true
    },
    {
      "action": "submitForm",
      "target": "auth.submit",
      "sensitive": true
    },
    {
      "action": "wait",
      "target": "auth.userDropdown"
    },
    {
      "action": "goto",
      "url": "/gov-store/admin/onboard/mine"
    },
    {
      "action": "assert",
      "target": "css=.govonboard-theme .gs-tag",
      "test": "text",
      "matches": "Waiting|WAITING|অপেক্ষ"
    },
    {
      "action": "actor",
      "name": "admin"
    },
    {
      "action": "goto",
      "url": "/gov-store/admin/onboard"
    },
    {
      "action": "capture",
      "target": "css=ul.pagination a[rel=next]",
      "count": true,
      "as": "hasNextPage"
    },
    {
      "action": "click",
      "target": "css=ul.pagination li:nth-last-child(2) a",
      "waitForNavigation": true,
      "when": {
        "actual": "${captured.hasNextPage}",
        "equals": 1
      }
    },
    {
      "action": "assert",
      "target": "css=.govonboard-theme tbody tr:has-text(\"${data.marker}\")",
      "test": "count",
      "equals": 1
    },
    {
      "action": "capture",
      "target": "css=.govonboard-theme tbody tr:has-text(\"${data.marker}\") form[action$=\"/assign\"] input[name=onboarding_id]",
      "value": true,
      "as": "onboardingId"
    },
    {
      "action": "capture",
      "target": "css=.govonboard-theme tbody tr:has-text(\"${data.marker}\") select[name=location_id] option[value=\"${fixtures.office.id}\"]",
      "as": "officeName"
    },
    {
      "action": "select",
      "target": "css=.govonboard-theme tbody tr:has-text(\"${data.marker}\") select[name=location_id]",
      "value": "${fixtures.office.id}"
    },
    {
      "action": "submitForm",
      "target": "css=.govonboard-theme tbody tr:has-text(\"${data.marker}\") form[action$=\"/assign\"] button[type=submit]",
      "rejectFlashErrors": true
    },
    {
      "action": "goto",
      "url": "/gov-store/admin/onboard",
      "query": {
        "status": "COMPLETED"
      }
    },
    {
      "action": "capture",
      "target": "css=ul.pagination a[rel=next]",
      "count": true,
      "as": "completedHasNext"
    },
    {
      "action": "click",
      "target": "css=ul.pagination li:nth-last-child(2) a",
      "waitForNavigation": true,
      "when": {
        "actual": "${captured.completedHasNext}",
        "equals": 1
      }
    },
    {
      "action": "assert",
      "target": "css=.govonboard-theme tbody tr:has-text(\"${data.marker}\")",
      "test": "visible"
    },
    {
      "action": "click",
      "target": "css=.govonboard-theme tbody tr:has-text(\"${data.marker}\") summary"
    },
    {
      "action": "assert",
      "target": "css=.govonboard-theme tbody tr:has-text(\"${data.marker}\") details",
      "test": "text",
      "matches": "First home office assigned|প্রথম মূল কার্যালয় বরাদ্দ"
    },
    {
      "action": "actor",
      "name": "newEmployee"
    },
    {
      "action": "goto",
      "url": "/gov-store/admin/onboard/mine"
    },
    {
      "action": "assert",
      "target": "css=.govonboard-theme",
      "test": "text",
      "contains": "${captured.officeName}"
    },
    {
      "action": "assert",
      "target": "css=.govonboard-theme .gs-tag",
      "test": "text",
      "matches": "Completed|COMPLETED|সম্পন্ন"
    },
    {
      "action": "goto",
      "url": "/gov-store/access"
    },
    {
      "action": "assert",
      "target": "css=.tenant-scope-theme[data-access-office=\"${fixtures.office.id}\"]",
      "test": "visible"
    },
    {
      "action": "assert",
      "target": "css=[data-access-ability=\"requests.submit\"]",
      "test": "visible"
    },
    {
      "action": "assert",
      "target": "css=[data-access-ability=\"organization.national.manage\"]",
      "test": "count",
      "equals": 0
    },
    {
      "action": "goto",
      "url": "/gov-requests/catalog"
    },
    {
      "action": "assert",
      "target": "css=[data-cr-catalog]",
      "test": "visible"
    },
    {
      "action": "assert",
      "target": "css=.cr-context",
      "test": "text",
      "contains": "${captured.officeName}"
    }
  ],
  "cleanup": {
    "policy": "supported-actions",
    "description": "Deactivate only the exact newly created fictional account; retain its first membership, onboarding history and audit.",
    "steps": [
      {
        "use": "auth.login",
        "with": {
          "actor": "admin"
        },
        "when": {
          "actual": "${captured.userId}",
          "notEquals": 0
        }
      },
      {
        "action": "goto",
        "url": "/users",
        "when": {
          "actual": "${captured.userId}",
          "notEquals": 0
        }
      },
      {
        "action": "fill",
        "target": "css=.fixed-table-toolbar .search input",
        "value": "${data.marker}",
        "when": {
          "actual": "${captured.userId}",
          "notEquals": 0
        }
      },
      {
        "action": "keyboard",
        "key": "Enter",
        "when": {
          "actual": "${captured.userId}",
          "notEquals": 0
        }
      },
      {
        "action": "wait",
        "target": "css=#ListingTable tbody tr:has-text(\"${data.marker}\")",
        "when": {
          "actual": "${captured.userId}",
          "notEquals": 0
        }
      },
      {
        "action": "assert",
        "target": "css=#ListingTable tbody tr:has-text(\"${data.marker}\")",
        "test": "count",
        "equals": 1,
        "when": {
          "actual": "${captured.userId}",
          "notEquals": 0
        }
      },
      {
        "action": "capture",
        "target": "css=#ListingTable tbody tr:has-text(\"${data.marker}\")",
        "attribute": "data-index",
        "as": "cleanupRowIndex",
        "when": {
          "actual": "${captured.userId}",
          "notEquals": 0
        }
      },
      {
        "action": "check",
        "target": "css=.fixed-columns tbody tr[data-index=\"${captured.cleanupRowIndex}\"] input[type=checkbox]",
        "when": {
          "actual": "${captured.userId}",
          "notEquals": 0
        }
      },
      {
        "action": "select",
        "target": "css=form[action$=\"/users/bulkedit\"] select[name=bulk_actions]",
        "value": "edit",
        "when": {
          "actual": "${captured.userId}",
          "notEquals": 0
        }
      },
      {
        "action": "submitForm",
        "target": "css=form[action$=\"/users/bulkedit\"] button",
        "rejectFlashErrors": true,
        "when": {
          "actual": "${captured.userId}",
          "notEquals": 0
        }
      },
      {
        "action": "assert",
        "target": "css=form:has(input[name^=\"ids[\"]) input[name^=\"ids[\"]",
        "test": "count",
        "equals": 1,
        "when": {
          "actual": "${captured.userId}",
          "notEquals": 0
        }
      },
      {
        "action": "assert",
        "target": "css=form:has(input[name^=\"ids[\"]) input[name^=\"ids[\"]",
        "test": "value",
        "equals": "${captured.userId}",
        "when": {
          "actual": "${captured.userId}",
          "notEquals": 0
        }
      },
      {
        "action": "check",
        "target": "css=#deactivated",
        "when": {
          "actual": "${captured.userId}",
          "notEquals": 0
        }
      },
      {
        "action": "submitForm",
        "target": "css=form:has(input[name^=\"ids[\"]) button[type=submit]",
        "rejectFlashErrors": true,
        "when": {
          "actual": "${captured.userId}",
          "notEquals": 0
        }
      },
      {
        "action": "goto",
        "url": "/users/${captured.userId}/edit",
        "when": {
          "actual": "${captured.userId}",
          "notEquals": 0
        }
      },
      {
        "action": "assert",
        "target": "css=#username",
        "test": "value",
        "equals": "${data.marker}",
        "when": {
          "actual": "${captured.userId}",
          "notEquals": 0
        }
      },
      {
        "action": "assert",
        "target": "css=#activated",
        "test": "checked",
        "equals": false,
        "when": {
          "actual": "${captured.userId}",
          "notEquals": 0
        }
      },
      {
        "action": "ledger",
        "kind": "fictional_onboarding_user",
        "id": "${captured.userId}",
        "effect": "Exact newly created fictional account deactivated through supported native bulk editor; first membership and audit retained",
        "cleanup": "removed",
        "when": {
          "actual": "${captured.userId}",
          "notEquals": 0
        }
      }
    ]
  }
}
