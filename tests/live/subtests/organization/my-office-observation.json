{
  "schemaVersion": 1,
  "id": "organization.my-office-observation",
  "title": "A local office administrator's My office page shows their office's status, readiness, read-only administrator slot, role pickers and staff as stored in the database",
  "features": ["organization.my-office"],
  "tags": ["seeded", "readonly", "organization"],
  "execution": { "capability": "observe", "language": "en-US", "timeoutMs": 90000, "accessMode": "any" },
  "fixtures": {
    "office": { "requirements": { "operational": true } },
    "actors": {
      "officeAdmin": { "role": "office_admin", "capabilities": { "allOf": ["organization.office.manage"], "noneOf": ["access.matrix", "organization.national.manage"] }, "office": "office", "activeMembership": true }
    }
  },
  "steps": [
    { "action": "observe", "check": "organization.office", "args": { "id": "${fixtures.office.id}" }, "as": "before" },
    { "use": "auth.login", "with": { "actor": "officeAdmin" } },

    { "action": "goto", "url": "/gov-store/office" },
    { "action": "observe", "check": "organization.office", "args": { "id": "${fixtures.office.id}" }, "as": "office", "note": "Re-read after the page evaluated readiness" },
    { "action": "compare", "actual": "${observed.office.status}", "equals": "${observed.before.status}" },
    { "action": "compare", "actual": "${observed.office.adminId}", "equals": "${actors.officeAdmin.id}", "note": "The fixture actor administers this office" },

    { "action": "assert", "target": "organization.pageTitle", "test": "text", "equals": "${observed.office.name}" },
    { "action": "assert", "target": "organization.pageSubtitle", "test": "text", "equals": "Finish setup so your staff can start ordering." },
    { "action": "assert", "target": "organization.headerBadgeExpected", "test": "count", "equals": 1, "note": "Header badge = persisted lifecycle status" },
    { "action": "assert", "target": "organization.readinessCount", "test": "text", "equals": "${observed.office.readinessCount}" },
    { "action": "assert", "target": "organization.readinessDone", "test": "count", "equals": "${observed.office.done}" },

    { "action": "assert", "target": "organization.adminPicker", "test": "count", "equals": 0, "note": "A local administrator cannot reassign the administrator role" },
    { "action": "assert", "target": "organization.myAdminSlotPerson", "test": "text", "equals": "${observed.office.adminName}" },
    { "action": "assert", "target": "organization.approverPicker", "test": "count", "equals": 1, "note": "Approver, storekeeper and second approver are chosen here" },
    { "action": "assert", "target": "organization.staffRows", "test": "count", "equals": "${observed.office.staff}" },
    { "action": "assert", "target": "organization.hubToc", "test": "count", "equals": 0, "note": "Hub-only sections (settings, lifecycle) are not on My office" },
    { "action": "assert", "target": "organization.settings", "test": "count", "equals": 0 }
  ],
  "cleanup": { "policy": "no-business-records-created" }
}
