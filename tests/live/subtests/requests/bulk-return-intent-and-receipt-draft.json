{
  "schemaVersion": 1,
  "id": "requests.bulk-return-intent-and-receipt-draft",
  "title": "Receive, approve, issue and acknowledge goods, then hand a return request to the storekeeper and prepare its linked receipt",
  "evidenceLevel": "connected",
  "features": [
    "storeops.grn",
    "requests.submit-approve-fulfill"
  ],
  "tags": [
    "functional",
    "multi-actor",
    "write",
    "connected"
  ],
  "execution": {
    "capability": "write-fixtures",
    "language": "en-US",
    "timeoutMs": 420000,
    "accessMode": "any"
  },
  "fixtures": {
    "office": {
      "requirements": {
        "operational": true,
        "ledgerOpen": true
      }
    },
    "actors": {
      "storekeeper": {
        "role": "storekeeper",
        "capabilities": {
          "allOf": [
            "storeops.documents.draft",
            "storeops.documents.post",
            "requests.fulfill"
          ]
        }
      },
      "employee": {
        "capabilities": {
          "allOf": [
            "requests.submit"
          ],
          "noneOf": [
            "requests.approve"
          ]
        },
        "emptyBasket": true
      },
      "approver": {
        "role": "primary_approver",
        "capabilities": {
          "allOf": [
            "requests.approve.primary"
          ]
        }
      }
    },
    "records": {
      "item": {
        "kind": "consumable",
        "minimumAvailable": 10,
        "policy": "PRIMARY_ONLY",
        "requestQuantity": 2
      }
    }
  },
  "data": {
    "qty": 2,
    "receiptQty": 6,
    "purpose": {
      "generate": "markedText",
      "prefix": "LIVE-E2E",
      "length": 6
    },
    "serial": {
      "generate": "markedText",
      "prefix": "LIVE-SN",
      "length": 8
    },
    "receiptDate": {
      "generate": "date",
      "offsetDays": 0
    }
  },
  "preconditions": [],
  "steps": [
    {
      "use": "storeops.receive-bulk"
    },
    {
      "use": "auth.login",
      "with": {
        "actor": "employee"
      }
    },
    {
      "action": "goto",
      "route": "gov.requests.catalog",
      "query": {
        "q": "${fixtures.item.name}"
      }
    },
    {
      "action": "click",
      "target": "catalog.itemAdd",
      "waitForResponse": "basket/add"
    },
    {
      "action": "fill",
      "target": "catalog.itemQty",
      "value": "${data.qty}"
    },
    {
      "action": "waitInspect",
      "check": "ui.basket",
      "args": {
        "name": "${fixtures.item.name}"
      },
      "path": "quantity",
      "equals": "${data.qty}",
      "timeoutMs": 15000
    },
    {
      "action": "ledger",
      "kind": "task_basket_line",
      "id": "${actors.employee.id}:${fixtures.item.id}",
      "effect": "Run-owned basket line; empty basket verified during fixture resolution",
      "cleanup": "retained"
    },
    {
      "action": "goto",
      "route": "gov.requests.basket"
    },
    {
      "action": "assert",
      "target": "requests.basketLines",
      "test": "count",
      "equals": 1
    },
    {
      "action": "assert",
      "target": "requests.basketQty",
      "test": "value",
      "equals": "${data.qty}"
    },
    {
      "action": "click",
      "target": "requests.basketToDetails"
    },
    {
      "action": "fill",
      "target": "requests.basketPurpose",
      "value": "${data.purpose}"
    },
    {
      "action": "fill",
      "target": "requests.basketJustification",
      "value": "Automated live journey justification for ${data.purpose}"
    },
    {
      "action": "click",
      "target": "requests.basketContinue"
    },
    {
      "action": "assert",
      "target": "requests.basketSubmit",
      "test": "visible"
    },
    {
      "action": "check",
      "target": "requests.basketDeclare"
    },
    {
      "action": "submitForm",
      "target": "requests.basketSubmit"
    },
    {
      "action": "assert",
      "test": "url",
      "contains": "/gov-requests/sent/"
    },
    {
      "action": "capture",
      "target": "requests.sentNumberFirst",
      "as": "requestNumber"
    },
    {
      "action": "capture",
      "target": "requests.sentNumberFirst",
      "attribute": "href",
      "pattern": "/my-requests/(\\d+)",
      "as": "requestId"
    },
    {
      "action": "ledger",
      "kind": "custom_service_request",
      "id": "${captured.requestNumber}",
      "effect": "Request created by the complete receipt, approval, fulfillment and acknowledgement journey",
      "cleanup": "retained"
    },
    {
      "use": "auth.login",
      "with": {
        "actor": "approver"
      }
    },
    {
      "action": "goto",
      "route": "gov.requests.admin.index",
      "query": {
        "q": "${captured.requestNumber}"
      }
    },
    {
      "action": "click",
      "target": "requests.approverRowOpen"
    },
    {
      "action": "wait",
      "target": "requests.decisionAsAsked",
      "state": "visible"
    },
    {
      "action": "click",
      "target": "requests.decisionSubmit"
    },
    {
      "action": "waitInspect",
      "check": "ui.request",
      "args": {
        "view": "admin",
        "id": "${captured.requestId}"
      },
      "path": "status",
      "equals": "request_approved",
      "as": "primary"
    },
    {
      "action": "compare",
      "actual": "${observed.primary.number}",
      "equals": "${captured.requestNumber}"
    },
    {
      "action": "waitInspect",
      "check": "ui.request",
      "args": {
        "view": "admin",
        "id": "${captured.requestId}"
      },
      "path": "status",
      "equals": "request_approved",
      "as": "approved"
    },
    {
      "action": "compare",
      "actual": "${observed.approved.number}",
      "equals": "${captured.requestNumber}"
    },
    {
      "action": "compare",
      "actual": "${observed.approved.lines.0.approved}",
      "equals": "${data.qty}"
    },
    {
      "action": "actor",
      "name": "storekeeper"
    },
    {
      "action": "goto",
      "route": "gov.requests.fulfillment.index",
      "query": {
        "q": "${captured.requestNumber}"
      }
    },
    {
      "action": "click",
      "target": "requests.fulfillmentRowOpen"
    },
    {
      "action": "wait",
      "target": "requests.issueSubmit",
      "state": "visible"
    },
    {
      "action": "fill",
      "target": "requests.issueQuantity",
      "value": "${data.qty}"
    },
    {
      "action": "submitForm",
      "target": "requests.issueSubmit"
    },
    {
      "action": "waitInspect",
      "check": "ui.request",
      "args": {
        "view": "fulfillment-register",
        "id": "${captured.requestId}"
      },
      "path": "status",
      "equals": "request_issued",
      "as": "issued"
    },
    {
      "action": "compare",
      "actual": "${observed.issued.number}",
      "equals": "${captured.requestNumber}"
    },
    {
      "action": "compare",
      "actual": "${observed.issued.lines.0.issued}",
      "equals": "${data.qty}"
    },
    {
      "action": "compare",
      "actual": "${observed.issued.history}",
      "contains": "${actors.storekeeper.display_name}"
    },
    {
      "action": "actor",
      "name": "employee"
    },
    {
      "action": "goto",
      "route": "gov.requests.user.index",
      "query": {
        "tab": "needs_you"
      }
    },
    {
      "action": "click",
      "target": "requests.requestShow"
    },
    {
      "action": "wait",
      "target": "requests.acknowledge",
      "state": "visible"
    },
    {
      "action": "assert",
      "target": "requests.requestLineIssued",
      "test": "number",
      "equals": "${data.qty}"
    },
    {
      "action": "submitForm",
      "target": "requests.acknowledge"
    },
    {
      "action": "reload"
    },
    {
      "action": "waitInspect",
      "check": "ui.request",
      "args": {
        "view": "my-requests",
        "id": "${captured.requestId}"
      },
      "path": "status",
      "equals": "request_received",
      "as": "received"
    },
    {
      "action": "compare",
      "actual": "${observed.received.number}",
      "equals": "${captured.requestNumber}"
    },
    {
      "action": "compare",
      "actual": "${observed.received.history}",
      "contains": "${actors.employee.display_name}"
    },
    {
      "action": "assert",
      "target": "css=[data-cr-request][data-status-key=\"request_received\"]",
      "test": "visible"
    },
    {
      "action": "assert",
      "target": "requests.acknowledge",
      "test": "count",
      "equals": 0
    },
    {
      "action": "actor",
      "name": "storekeeper"
    },
    {
      "action": "inspect",
      "check": "ui.stockCard",
      "args": {
        "type": "consumable",
        "id": "${fixtures.item.id}"
      },
      "as": "finalStock"
    },
    {
      "action": "compare",
      "actual": "${observed.afterReceipt.closing}",
      "equals": 2,
      "deltaFrom": "${observed.finalStock.closing}"
    },
    {
      "action": "actor",
      "name": "employee"
    },
    {
      "action": "goto",
      "url": "/gov-requests/my-requests/${captured.requestId}"
    },
    {
      "action": "click",
      "target": "css=#return summary"
    },
    {
      "action": "fill",
      "target": "css=#return textarea[name=reason]",
      "value": "${data.purpose} - fictional goods being returned to store"
    },
    {
      "action": "submitForm",
      "target": "css=#return button[type=submit]",
      "rejectFlashErrors": true
    },
    {
      "action": "assert",
      "target": "css=[data-cr-request][data-status-key=request_return_requested]",
      "test": "visible"
    },
    {
      "action": "assert",
      "target": "css=#return",
      "test": "count",
      "equals": 0
    },
    {
      "action": "actor",
      "name": "storekeeper"
    },
    {
      "action": "goto",
      "url": "/gov-requests/fulfillment",
      "query": {
        "tab": "returns",
        "q": "${captured.requestNumber}"
      }
    },
    {
      "action": "assert",
      "target": "css=.cr-queue",
      "test": "text",
      "contains": "${data.purpose}"
    },
    {
      "action": "click",
      "target": "css=.cr-queue a[href$=\"/fulfillment-register/${captured.requestId}\"]",
      "waitForNavigation": true
    },
    {
      "action": "assert",
      "target": "css=[data-cr-record]",
      "test": "text",
      "contains": "${data.purpose}"
    },
    {
      "action": "submitForm",
      "target": "css=form[action$=\"/fulfillment-register/${captured.requestId}/return\"] button[type=submit]",
      "rejectFlashErrors": true
    },
    {
      "action": "capture",
      "url": true,
      "pattern": "/documents/receipt/([0-9a-f-]{36})",
      "as": "returnDocumentId"
    },
    {
      "action": "ledger",
      "kind": "return_receipt_draft",
      "id": "${captured.returnDocumentId}",
      "effect": "Linked return receipt for the exact issued goods, pending physical receipt metadata and posting",
      "cleanup": "retained"
    },
    {
      "action": "assert",
      "target": "storeops.row0Qty",
      "test": "value",
      "equals": "${data.qty}"
    },
    {
      "action": "assert",
      "target": "storeops.row0Item",
      "test": "value",
      "equals": "consumable_${fixtures.item.id}"
    },
    {
      "action": "inspect",
      "check": "ui.stockCard",
      "args": {
        "type": "consumable",
        "id": "${fixtures.item.id}"
      },
      "as": "afterReturnDraft"
    },
    {
      "action": "compare",
      "actual": "${observed.afterReturnDraft.closing}",
      "equals": "${observed.finalStock.closing}"
    },
    {
      "action": "actor",
      "name": "employee"
    },
    {
      "action": "goto",
      "url": "/gov-requests/my-requests/${captured.requestId}"
    },
    {
      "action": "assert",
      "target": "css=[data-cr-request][data-status-key=request_return_drafted]",
      "test": "visible"
    },
    {
      "action": "assert",
      "target": "requests.requestLineIssued",
      "test": "number",
      "equals": "${data.qty}"
    }
  ],
  "cleanup": {
    "policy": "retained-with-report",
    "description": "Request, posted documents and audit retained; only the exact run-owned basket line is removed through the UI. Successful native check-in returns its fictional asset to stock.",
    "steps": [
      {
        "use": "auth.login",
        "with": {
          "actor": "employee"
        }
      },
      {
        "action": "inspect",
        "check": "ui.basket",
        "args": {
          "name": "${fixtures.item.name}"
        },
        "as": "cleanupBasket"
      },
      {
        "action": "goto",
        "route": "gov.requests.basket",
        "when": {
          "actual": "${observed.cleanupBasket.quantity}",
          "notEquals": 0
        }
      },
      {
        "action": "click",
        "target": "requests.basketRemove",
        "when": {
          "actual": "${observed.cleanupBasket.quantity}",
          "notEquals": 0
        },
        "waitForResponse": "basket/remove"
      },
      {
        "action": "waitInspect",
        "check": "ui.basket",
        "args": {
          "name": "${fixtures.item.name}"
        },
        "path": "quantity",
        "equals": 0
      },
      {
        "action": "ledger",
        "kind": "task_basket_line",
        "id": "${actors.employee.id}:${fixtures.item.id}",
        "effect": "Temporary basket line consumed or removed; zero quantity verified",
        "cleanup": "removed"
      }
    ]
  },
  "description": "Verifies return intent, reason visibility, exact original quantities, linked draft identity and no stock increase before physical receipt posting. Posting this return is still a separate acceptance branch."
}
