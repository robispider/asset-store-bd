{
  "schemaVersion": 1,
  "id": "requests.my-requests-observation",
  "title": "My requests: tab counts equal the derived request statuses and nothing changes",
  "features": [
    "requests.my-requests"
  ],
  "tags": [
    "seeded",
    "readonly"
  ],
  "execution": {
    "capability": "observe",
    "language": "en-US",
    "timeoutMs": 60000
  },
  "fixtures": {
    "office": {
      "requirements": {
        "operational": true
      }
    },
    "actors": {
      "employee": {
        "capabilities": {
          "allOf": [
            "requests.submit"
          ]
        },
        "office": "office",
        "activeMembership": true
      }
    }
  },
  "steps": [
    {
      "action": "observe",
      "check": "request.list",
      "args": {
        "userId": "${actors.employee.id}",
        "officeId": "${fixtures.office.id}"
      },
      "as": "before"
    },
    {
      "use": "auth.login",
      "with": {
        "actor": "employee"
      }
    },
    {
      "action": "goto",
      "route": "gov.requests.user.index",
      "query": {
        "tab": "finished"
      }
    },
    {
      "action": "assert",
      "target": "requests.myTabActive",
      "test": "number",
      "equals": "${observed.before.tabs.active}"
    },
    {
      "action": "assert",
      "target": "requests.myTabNeedsYou",
      "test": "number",
      "equals": "${observed.before.tabs.needs_you}"
    },
    {
      "action": "assert",
      "target": "requests.myTabFinished",
      "test": "number",
      "equals": "${observed.before.tabs.finished}"
    },
    {
      "action": "observe",
      "check": "request.list",
      "args": {
        "userId": "${actors.employee.id}",
        "officeId": "${fixtures.office.id}"
      },
      "as": "after"
    },
    {
      "action": "compare",
      "actual": "${observed.after.total}",
      "equals": "${observed.before.total}"
    }
  ],
  "cleanup": {
    "policy": "no-business-records-created"
  },
  "description": "Reads only. Viewing My requests marks the person's own updates as read (read_at); no request changes."
}
