{
  "execution": {
    "language": "en-US",
    "timeoutMs": 60000,
    "accessMode": "any",
    "capability": "observe"
  },
  "id": "user-stories.us-17",
  "title": "US-17 — Verify office and ministry isolation (seeded UI entry check)",
  "fixtures": {
    "office": {
      "requirements": {
        "operational": true
      }
    },
    "actors": {
      "employee": {
        "office": "office",
        "capabilities": {
          "allOf": [
            "requests.submit"
          ],
          "noneOf": []
        },
        "activeMembership": true
      }
    }
  },
  "schemaVersion": 1,
  "cleanup": {
    "policy": "no-business-records-created"
  },
  "steps": [
    {
      "use": "auth.login",
      "with": {
        "actor": "employee"
      }
    },
    {
      "as": "pageStatus",
      "expectStatus": [
        200
      ],
      "action": "probe",
      "path": "/gov-store/committees/registry"
    },
    {
      "url": "/gov-store/committees/registry",
      "action": "goto"
    },
    {
      "test": "visible",
      "action": "assert",
      "target": "css=body"
    },
    {
      "contains": "/gov-store/committees/registry",
      "test": "url",
      "action": "assert"
    }
  ],
  "tags": [
    "user-story",
    "seeded",
    "readonly",
    "entry-check"
  ],
  "features": [
    "user-story.us-17"
  ]
}
