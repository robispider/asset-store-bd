{
  "execution": {
    "language": "en-US",
    "timeoutMs": 60000,
    "accessMode": "any",
    "capability": "observe"
  },
  "id": "user-stories.us-19",
  "title": "US-19 — Record asset maintenance (seeded UI entry check)",
  "fixtures": {
    "office": {
      "requirements": {
        "operational": true
      }
    },
    "actors": {
      "assetManager": {
        "office": "office",
        "capabilities": {
          "allOf": [
            "storeops.documents.view"
          ],
          "noneOf": []
        },
        "activeMembership": true,
        "role": "storekeeper"
      }
    }
  },
  "schemaVersion": 1,
  "cleanup": {
    "policy": "no-business-records-created"
  },
  "steps": [
    {
      "use": "auth.login",
      "with": {
        "actor": "assetManager"
      }
    },
    {
      "url": "/hardware",
      "action": "goto"
    },
    {
      "test": "visible",
      "action": "assert",
      "target": "css=body"
    },
    {
      "contains": "/hardware",
      "test": "url",
      "action": "assert"
    }
  ],
  "tags": [
    "user-story",
    "seeded",
    "readonly",
    "entry-check"
  ],
  "features": [
    "user-story.us-19"
  ]
}
