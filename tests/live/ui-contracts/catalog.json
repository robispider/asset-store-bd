{
  "schemaVersion": 1,
  "id": "catalog",
  "locators": {
    "productCount": {
      "css": "[data-cr-results-count]",
      "description": "Result count sentence"
    },
    "search": {
      "css": "#cr-q",
      "description": "Live item search box"
    },
    "itemCard": {
      "css": ".cr-good:has(.cr-good__name:text-is(\"${fixtures.item.name}\"))",
      "description": "Card or list row of the pinned fixture item"
    },
    "itemQty": {
      "css": ".cr-good:has(.cr-good__name:text-is(\"${fixtures.item.name}\")) [data-cr-line-qty]",
      "description": "Quantity of the pinned item once it is in the draft (saves as you type)"
    },
    "itemAdd": {
      "css": ".cr-good:has(.cr-good__name:text-is(\"${fixtures.item.name}\")) [data-cr-add] button[type='submit']",
      "description": "Add button on the pinned item (adds 1; the card then shows a quantity)"
    },
    "itemStatus": {
      "css": ".cr-good:has(.cr-good__name:text-is(\"${fixtures.item.name}\")) .cr-good__in",
      "description": "'In your draft' on the pinned item"
    },
    "draftPanel": {
      "css": "[data-cr-drawer] .cr-drawer",
      "description": "Draft panel beside the items (always current)"
    },
    "viewList": {
      "css": "[data-cr-view='list']",
      "description": "Cards / List switch: List"
    },
    "goodsList": {
      "css": ".cr-goods--list",
      "description": "Items shown as a list"
    }
  },
  "labels": {
    "en-US": {},
    "bn-BD": {}
  }
}
