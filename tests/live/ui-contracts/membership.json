{
  "schemaVersion": 1,
  "id": "membership",
  "locators": {
    "pageTitle": {
      "css": ".govmem .gs-page-header__title",
      "description": "Page header title (h1) of an office membership screen"
    },
    "pageSubtitle": {
      "css": ".govmem .gs-page-header__subtitle",
      "description": "Page header subtitle"
    },
    "errorSummary": {
      "css": ".govmem .gs-alert--danger",
      "description": "Error summary (refusals and validation)"
    },
    "successFlash": {
      "css": ".alert-success, .gs-alert--success",
      "description": "Success message after an action"
    },
    "joinButton": {
      "css": ".govmem .gs-page-header__actions a[href$=\"/gov-store/my-memberships/join\"]",
      "description": "My offices: Join another office"
    },
    "officeCards": {
      "css": ".govmem .govmem-office",
      "description": "My offices: one card per current office"
