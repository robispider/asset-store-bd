{
  "schemaVersion": 1,
  "id": "requests",
  "locators": {
    "basketQty": {
      "css": "[data-cr-line]:has-text(\"${fixtures.item.name}\") input[data-cr-line-qty]",
      "description": "Quantity input of the pinned fixture item line on the draft"
    },
    "basketPurpose": {
      "css": "#cr-field-purpose",
      "description": "What is it for? field"
    },
    "basketJustification": {
      "css": "#cr-field-justification",
      "description": "Why is it needed? field"
    },
    "basketSubmit": {
      "css": "form[data-cr-send] [data-cr-submit]",
      "description": "Send the request(s) button in the review step"
    },
    "basketRemove": {
      "css": "[data-cr-line]:has-text(\"${fixtures.item.name}\") form[action*='basket/remove'] button[type='submit']",
      "description": "Remove button on the pinned fixture item line"
    },
    "basketLines": {
      "css": "[data-cr-line]:has-text(\"${fixtures.item.name}\")",
      "description": "Draft lines for the pinned fixture item"
    },
    "myNumberByPurpose": {
      "css": "[data-request-number]:has([data-cr-purpose]:has-text(\"${data.purpose}\")) .cr-request__number",
      "description": "Request number on the My requests card for the generated purpose"
    },
    "myRowByNumber": {
      "css": "[data-request-number=\"${captured.requestNumber}\"]",
      "description": "My requests card for the captured request"
    },
    "approverRowOpen": {
      "css": "[data-request-number=\"${captured.requestNumber}\"] a.gs-btn[href*=\"/gov-requests/admin/\"]",
      "description": "Decide link on the approver card for the captured request"
    },
    "approverRowByNumber": {
      "css": "[data-request-number=\"${captured.requestNumber}\"]",
      "description": "Approver card for the captured request"
    },
    "decisionSubmit": {
      "css": "form[data-cr-decision-form] button[type='submit']",
      "description": "Save the decision button"
    },
    "decisionQty": {
      "css": "input[name$='[qty]']",
      "description": "Approve how many? input (shown for Approve fewer)"
    },
    "decisionFieldset": {
      "css": "form[data-cr-decision-form] fieldset",
      "description": "Decision form fieldset"
    },
    "flashSuccess": {
      "css": ".alert-success",
      "description": "Success flash"
    },
    "flashError": {
      "css": "[data-cr-errors], .alert-danger",
      "description": "Error summary or flash"
    },
    "approverOpenButtons": {
      "css": "[data-cr-approvals] a[href*='/gov-requests/admin/']",
      "description": "Decide links on the approver list"
    },
    "fulfillmentOpenButtons": {
      "css": "[data-cr-to-issue] a[href*='/gov-requests/fulfillment/']",
      "description": "Issue links in the To issue queue"
    },
    "basketContinue": {
      "css": "[data-cr-next='3']",
      "description": "Continue to review: checks the details step in place and opens the review"
    },
    "basketSplit": {
      "css": "#cr-split",
      "description": "Split preview shown when the draft becomes more than one request"
    },
    "myStatusByNumber": {
      "css": "[data-request-number=\"${captured.requestNumber}\"] .gs-badge",
      "description": "Status badge on the My requests card for the captured request"
    },
    "requestNextStep": {
      "css": "[data-cr-next-step]",
      "description": "What happens next sentence on the request page"
    },
    "requestLine": {
      "css": "tr[data-line-id]",
      "description": "Line rows on the request page"
    },
    "decisionAsAsked": {
      "css": "input[name$='[choice]'][value='as_asked']",
      "description": "Approve as asked choice"
    },
    "myTabActive": {
      "css": "nav.gs-status-tabs a[href*='tab=active'] .gs-tabs__count",
      "description": "Count on the My requests 'active' tab"
    },
    "myTabNeedsYou": {
      "css": "nav.gs-status-tabs a[href*='tab=needs_you'] .gs-tabs__count",
      "description": "Count on the My requests 'needs_you' tab"
    },
    "myTabFinished": {
      "css": "nav.gs-status-tabs a[href*='tab=finished'] .gs-tabs__count",
      "description": "Count on the My requests 'finished' tab"
    },
    "myFirstNumber": {
      "css": "[data-cr-my-requests] [data-request-number] .cr-request__number >> nth=0",
      "description": "First request number on the open My requests tab"
    },
    "basketToDetails": {
      "css": "[data-cr-panel=\"1\"] [data-cr-next=\"2\"]",
      "description": "Continue to details (checkout step 1 → 2)"
    },
    "basketDeclare": {
      "css": "#cr-field-declared",
      "description": "Declaration checkbox on the review step"
    },
    "basketChanged": {
      "css": "#cr-changed",
      "description": "What changed since the review, when sending was stopped"
    },
    "sentNumberFirst": {
      "css": "[data-cr-sent] [data-request-number] .cr-sent__number a",
      "description": "First request number on the Sent page"
    },
    "fulfillmentRowOpen": {
      "css": "[data-request-number=\"${captured.requestNumber}\"] a[href*=\"/gov-requests/fulfillment/\"]",
      "description": "fulfillmentRowOpen"
    },
    "issueQuantity": {
      "css": "[data-cr-bulk]",
      "description": "issueQuantity"
    },
    "issueSubmit": {
      "css": "[data-cr-issue-submit]",
      "description": "issueSubmit"
    },
    "issueAsset": {
      "css": "input[type=\"checkbox\"][name^=\"issue[\"][value=\"${observed.receipt.assets.0.id}\"]",
      "description": "issueAsset"
    },
    "acknowledge": {
      "css": "form[action$=\"/receive\"] button[type=\"submit\"]",
      "description": "acknowledge"
    },
    "requestShow": {
      "css": "[data-request-number=\"${captured.requestNumber}\"] a.cr-request__number",
      "description": "requestShow"
    },
    "requestRoot": {
      "css": "[data-cr-request][data-request-number=\"${captured.requestNumber}\"]",
      "description": "requestRoot"
    },
    "requestLineRequested": {
      "css": "tr[data-line-id] td:nth-child(2)",
      "description": "requestLineRequested"
    },
    "requestLineApproved": {
      "css": "tr[data-line-id] td:nth-child(3)",
      "description": "requestLineApproved"
    },
    "requestLineIssued": {
      "css": "tr[data-line-id] td:nth-child(4)",
      "description": "requestLineIssued"
    }
  },
  "labels": {
    "en-US": {},
    "bn-BD": {}
  }
}
