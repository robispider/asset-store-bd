{
  "schemaVersion": 1,
  "id": "rules",
  "description": "Rules studio (product rules hub, policy wizard, policy editor, simulator).",
  "locators": {
    "studio": { "css": "[data-rules-studio]", "description": "Rules studio root" },
    "tagRule": { "css": "a.rst-row[data-rst-rule='issue_govt_tags']", "description": "'Issue Govt. Tags' row in What applies here" },
    "tagRuleOn": { "css": "a.rst-row[data-rst-rule='issue_govt_tags'] .rst-st--on", "description": "The rule's result is on" },
    "tagRuleOff": { "css": "a.rst-row[data-rst-rule='issue_govt_tags'] .rst-st--off", "description": "The rule's result is off" },
    "tagRuleBy": { "css": "a.rst-row[data-rst-rule='issue_govt_tags'] .rst-row__by", "description": "Who decides the rule" },
    "tagRuleNote": { "css": "a.rst-row[data-rst-rule='issue_govt_tags'] .rst-row__note", "description": "Layer / override note" },
    "tagWhy": { "css": "section[data-rst-why='issue_govt_tags']", "description": "Why panel for the rule" },
    "tagWhySteps": { "css": "section[data-rst-why='issue_govt_tags'] .rst-step", "description": "One step per layer" },
    "attachPolicy": { "css": "#rst-attach-policy", "description": "Policy to attach at the selected level" },
    "attachSubmit": { "css": ".rst-attach form[action$='/assign'] button[type='submit']", "description": "Attach / replace" },
    "detach": { "css": ".rst-attach .storeops-unassign button[type='submit']", "description": "Detach the policy at the selected level" },
    "attachedText": { "css": ".rst-attach > span", "description": "Selected level and its attached policy" },
    "wizardName": { "css": "#input_rule_name", "description": "Policy wizard: name" },
    "wizardNext": { "css": "#btn_next", "description": "Policy wizard: next" },
    "wizardSubmit": { "css": "#btn_submit", "description": "Policy wizard: create draft" },
    "openBuilder": { "css": "a.action-btn[href*='/edit']", "description": "Confirmation hub: open the policy builder" },
    "editorTagOff": { "css": "input[name='rules[issue_govt_tags][behavior]'][value='DISABLE']", "description": "Editor: Issue Govt. Tags → off" },
    "editorTagOffLabel": { "css": "label:has(> input[name='rules[issue_govt_tags][behavior]'][value='DISABLE'])", "description": "Editor: the 'off' choice label" },
    "editorSave": { "css": "#rst-editor-form button[type='submit']", "description": "Editor: save draft" },
    "editorPublish": { "css": "#btn_trigger_publish", "description": "Editor: validate and publish" },
    "publishModal": { "css": "#publishModal", "description": "Publish impact modal" },
    "publishConfirm": { "css": "#btn_confirm_publish", "description": "Publish and apply" },
    "simLocation": { "css": "#simulatorForm select[name='location_id']", "description": "Simulator: office" },
    "simCategory": { "css": "#simulatorForm select[name='category_id']", "description": "Simulator: product type" },
    "simRun": { "css": "#simulatorForm button[type='submit']", "description": "Simulator: run" },
    "simResults": { "css": "#simulation_results", "description": "Simulator results" }
  },
  "labels": { "en-US": {}, "bn-BD": {} }
}
