{
  "schemaVersion": 1,
  "id": "storeops",
  "description": "Store operations hub and the GRN (receipt) workspace.",
  "locators": {
    "hubStartDialog": { "css": "dialog#storeops-start", "description": "Start a document dialog" },
    "hubStartReceipt": { "css": "#storeops-start-receipt", "description": "Choice: goods received (GRN)" },
    "hubStartSubmit": { "css": "#storeops-start button[type='submit']", "description": "Create the draft" },
    "readOnly": { "css": ".storeops-theme > .alert-info[role='status']", "description": "Read-only banner on a document" },
    "ledgerClosed": { "css": ".storeops-theme > .alert-info:has-text('opening')", "description": "Ledger opening required banner" },
    "inlineError": { "css": "#gov-access-inline:not([hidden])", "description": "Workspace inline error" },
    "purchaseType": { "css": "select[name='purchase_type']", "description": "Receiving source" },
    "challanNumber": { "css": "input[name='references[0][reference_number]']", "description": "Supplier challan number" },
    "challanDate": { "css": "input[name='references[0][reference_date]']", "description": "Supplier challan date" },
    "poNumber": { "css": "input[name='references[1][reference_number]']", "description": "Purchase order number" },
    "poDate": { "css": "input[name='references[1][reference_date]']", "description": "Purchase order date" },
    "row0Item": { "css": "select[name='items[0][id]']", "description": "Line 1 item (select2)" },
    "row0Qty": { "css": "input[name='items[0][qty]']", "description": "Line 1 quantity" },
    "row0Cost": { "css": "input[name='items[0][unit_cost]']", "description": "Line 1 unit cost" },
    "row1Item": { "css": "select[name='items[1][id]']", "description": "Line 2 item (select2)" },
    "row1Qty": { "css": "input[name='items[1][qty]']", "description": "Line 2 quantity" },
    "row1Cost": { "css": "input[name='items[1][unit_cost]']", "description": "Line 2 unit cost" },
    "row2Item": { "css": "select[name='items[2][id]']", "description": "Line 3 item (select2)" },
    "row2Qty": { "css": "input[name='items[2][qty]']", "description": "Line 3 quantity" },
    "row2Cost": { "css": "input[name='items[2][unit_cost]']", "description": "Line 3 unit cost" },
    "addRow": { "css": "#addRowBtn", "description": "Add a line" },
    "itemRows": { "css": "#gridBody tr.item-row", "description": "Line rows" },
    "checklistItems": { "css": "#checklistRequirements li", "description": "Validation checklist rows" },
    "checklistFailing": { "css": "#checklistRequirements li:has(.text-red)", "description": "Required checklist rows that fail (red cross; Font Awesome may render the icon as an inline SVG)" },
    "checklistPassing": { "css": "#checklistRequirements li:has(.text-green)", "description": "Required checklist rows that pass" },
    "checklistWarnings": { "css": "#checklistRequirements li.storeops-check--warning", "description": "Warning checklist rows (never block)" },
    "saveDraft": { "css": "#saveDraftBtn", "description": "Save draft" },
    "post": { "css": "#triggerPostBtn", "description": "Post" },
    "postingModal": { "css": "#postingModal", "description": "Posting confirmation modal" },
    "previewTags": { "css": "#previewTags", "description": "Posting modal: tags line" },
    "previewQty": { "css": "#previewQty", "description": "Posting modal: total quantity" },
    "confirmPost": { "css": "#confirmPostBtn", "description": "Posting modal: confirm" },
    "postedBox": { "css": ".box.box-success", "description": "Posted document status box" },
    "documentNumber": { "css": ".col-md-4 .box h4 strong", "description": "Document number" },
    "voidOpen": { "css": "button[data-target='#voidDraftModal']", "description": "Open the void dialog" },
    "voidReason": { "css": "#voidReason", "description": "Void reason" },
    "voidSubmit": { "css": "#voidDraftModal button[type='submit']", "description": "Void the draft" }
  },
  "labels": { "en-US": {}, "bn-BD": {} }
}
