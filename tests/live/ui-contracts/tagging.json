{
  "schemaVersion": 1,
  "id": "tagging",
  "description": "Asset tagging screens: native asset-tag settings (G1), Finance list, product-type Finance Code, company code lists, office tag settings, enablement console, national change review, tag lookup and the GRN tag panel / issued-tags box.",
  "locators": {
    "page": { "css": ".at-page", "description": "Any asset-tagging page body" },
    "successAlert": { "css": ".gs-alert--success", "description": "Success flash on a gov-store kit page" },
    "dangerAlert": { "css": ".gs-alert--danger", "description": "Error flash on a gov-store kit page" },
    "readinessItems": { "css": ".at-page .gs-readiness__item", "description": "Rows of a readiness (gates) checklist" },
    "readinessDone": { "css": ".at-page .gs-readiness__item--done", "description": "Passed gate rows" },

    "nativeAutoIncrement": { "css": "#auto_increment_assets", "description": "Snipe-IT asset tag auto-increment checkbox" },
    "nativePrefix": { "css": "#auto_increment_prefix", "description": "Snipe-IT asset tag prefix" },
    "nativeSave": { "css": "form[action$='/admin/asset_tags'] button[type='submit']", "description": "Save asset tag settings" },

    "financeCheckbox": { "css": "#finance-bulk input[name='codes[]'][value='${fixtures.desktopCode.gov_code}']", "description": "Select the Desktop Computer Finance item" },
    "financeCheckboxScanner": { "css": "#finance-bulk input[name='codes[]'][value='${fixtures.scannerCode.gov_code}']", "description": "Select the Scanner Finance item" },
    "financeAuthority": { "css": "#authority_reference", "description": "Activation authority reference" },
    "financeActivate": { "css": "#finance-bulk button[type='submit']", "description": "Activate the selected Finance items" },

    "productTypeFinance": { "css": "#finance_gov_code", "description": "Product type Finance Code select (select2)" },
    "productTypeFinanceSave": { "css": "form[action*='/finance-code'] button[type='submit']", "description": "Save the product type Finance Code" },
    "productTypeFinanceShown": { "css": ".gs-finance-default code.gs-mono", "description": "The product type's saved Finance Code" },

    "reviewReason": { "css": "#changeReason", "description": "National change review: reason" },
    "reviewConfirm": { "css": "#changeConfirm", "description": "National change review: type CHANGE" },
    "reviewSubmit": { "css": "form:has(input[name='review_token']) button[type='submit']", "description": "National change review: confirm" },
    "reviewToken": { "css": "input[name='review_token']", "description": "Present only on the national change review page" },

    "codesLocation0Code": { "css": "#locations-0-code", "description": "Location list row 1 code" },
    "codesLocation0Name": { "css": "#locations-0-name", "description": "Location list row 1 name" },
    "codesLocation1Code": { "css": "#locations-1-code", "description": "Location list row 2 code" },
    "codesLocation1Name": { "css": "#locations-1-name", "description": "Location list row 2 name" },
    "codesDivision0Code": { "css": "#divisions-0-code", "description": "Division list row 1 code" },
    "codesDivision0Name": { "css": "#divisions-0-name", "description": "Division list row 1 name" },
    "codesDivision1Code": { "css": "#divisions-1-code", "description": "Division list row 2 code" },
    "codesDivision1Name": { "css": "#divisions-1-name", "description": "Division list row 2 name" },
    "codesSave": { "css": "form[action$='/asset-tags/codes'] button[type='submit']", "description": "Save company code lists" },
    "codesUsedBadges": { "css": "form[action$='/asset-tags/codes'] .gs-tag--info", "description": "'Used by N offices' badges on code-list rows" },

    "officeLocation": { "css": "#location_code", "description": "Office registration location select" },
    "officeDivisionA": { "css": "input[name='division_codes[]'][value='${data.divisionA}']", "description": "Division A checkbox" },
    "officeDivisionB": { "css": "input[name='division_codes[]'][value='${data.divisionB}']", "description": "Division B checkbox" },
    "officeDivisionChecks": { "css": "input[name='division_codes[]']", "description": "All division checkboxes" },
    "officeDefaultDivision": { "css": "#default_division_code", "description": "Default division select" },
    "officeSave": { "css": "form[action$='/asset-tags/settings'] button[type='submit']", "description": "Save office tag settings" },
    "officePreviewLocation": { "css": ".at-preview .gs-seg:nth-child(5) .gs-seg__v", "description": "Preview: location segment (LL)" },
    "officePreviewDivision": { "css": ".at-preview .gs-seg:nth-child(6) .gs-seg__v", "description": "Preview: division segment (DD)" },
    "settingsTabs": { "css": ".gs-status-tabs .gs-tabs__link", "description": "Settings tabs (office / company codes)" },

    "enableRow": { "css": "tr:has(#reason-${fixtures.office.id})", "description": "Enablement console row of the resolved office" },
    "enableRowPassed": { "css": "tr:has(#reason-${fixtures.office.id}) .gs-tag--success.gs-tag--outline", "description": "Passed office gate badges in that row" },
    "enableReason": { "css": "#reason-${fixtures.office.id}", "description": "Enable/disable reason of the resolved office" },
    "enableSubmit": { "css": "tr:has(#reason-${fixtures.office.id}) form button[type='submit']", "description": "Enable or disable button of the resolved office" },
    "enableRowSibling": { "css": "tr:has(#reason-${fixtures.sibling.id})", "description": "Enablement console row of the sibling office" },
    "enableState": { "css": "tr:has(#reason-${fixtures.office.id}) td:nth-child(4) .gs-tag", "description": "Enabled / not enabled badge" },
    "installationGates": { "css": ".at-page .gs-readiness__item", "description": "Installation gate rows on the console" },

    "lookupInput": { "css": "#lookup-tag", "description": "Tag lookup input" },
    "lookupSubmit": { "css": ".at-page form[role='search'] button[type='submit']", "description": "Tag lookup search" },
    "lookupNone": { "css": ".at-page .gs-empty", "description": "Neutral 'no tag found' state" },
    "lookupGovtBadge": { "css": ".at-page .gs-tag--primary", "description": "Govt. Tag badge in a lookup result" },
    "lookupStandardBadge": { "css": ".at-page .gs-box .gs-tag--secondary:not(.gs-tag--outline)", "description": "Standard tag badge in a lookup result" },
    "lookupSegments": { "css": ".at-page .gs-segs .gs-seg__v", "description": "Decoded tag segments" },
    "lookupFacts": { "css": ".at-page .gs-kv__item", "description": "Asset facts / registration rows" },

    "panel": { "css": "tr[data-parent-index='${data.row}'] .at-tagpanel", "description": "Tag panel of GRN line data.row" },
    "panel0": { "css": "tr[data-parent-index='0'] .at-tagpanel", "description": "Tag panel of line 1" },
    "panel1": { "css": "tr[data-parent-index='1'] .at-tagpanel", "description": "Tag panel of line 2" },
    "panel2": { "css": "tr[data-parent-index='2'] .at-tagpanel", "description": "Tag panel of line 3" },
    "panel0Govt": { "css": "tr[data-parent-index='0'] .at-tagpanel__head .gs-tag--primary", "description": "Line 1: Govt. Tag badge" },
    "panel1Govt": { "css": "tr[data-parent-index='1'] .at-tagpanel__head .gs-tag--primary", "description": "Line 2: Govt. Tag badge" },
    "panel2Standard": { "css": "tr[data-parent-index='2'] .at-tagpanel__head .gs-tag--secondary", "description": "Line 3: standard tag badge" },
    "panel0Standard": { "css": "tr[data-parent-index='0'] .at-tagpanel__head .gs-tag--secondary", "description": "Line 1: standard tag badge" },
    "panel0FromType": { "css": "tr[data-parent-index='0'] .at-tagpanel__row .gs-tag--info", "description": "Line 1: 'from product type' badge" },
    "panel0Code": { "css": "tr[data-parent-index='0'] .at-tagpanel__row strong.gs-mono", "description": "Line 1: Finance Code shown from the product type" },
    "panel0Owner": { "css": "tr[data-parent-index='0'] .at-owner", "description": "Line 1: who owns the Finance default" },
    "panel0Segments": { "css": "tr[data-parent-index='0'] .at-preview .gs-seg__v", "description": "Line 1: preview segments" },
    "panel0Pending": { "css": "tr[data-parent-index='0'] .at-preview .gs-seg--pending", "description": "Line 1: pending sequence segment" },
    "panel0Division": { "css": "#at-division-0", "description": "Line 1: division choice (offices with several divisions)" },
    "panel0DateAttention": { "css": "tr[data-parent-index='0'] .at-note--danger", "description": "Line 1: needs-attention note (acquisition date)" },
    "panel0UseStandard": { "css": "tr[data-parent-index='0'] .at-note--danger button[data-storeops-set][data-value='standard']", "description": "Line 1: 'use a standard tag' fix" },
    "panel0GoToDate": { "css": "tr[data-parent-index='0'] button[data-storeops-focus]", "description": "Line 1: 'go to the date' fix" },
    "panel0StandardChosen": { "css": "tr[data-parent-index='0'] .at-note--info", "description": "Line 1: standard tag chosen note" },
    "panel0UseGovt": { "css": "tr[data-parent-index='0'] button[data-storeops-set][data-value='']", "description": "Line 1: back to a Govt. Tag" },
    "panel0ReceivingSource": { "css": "tr[data-parent-index='0'] .at-note--info", "description": "Line 1: receiving-source note (donation etc.)" },
    "panel0Paused": { "css": "tr[data-parent-index='0'] .at-note--warning .fa-pause-circle", "description": "Line 1: issuance paused note" },
    "panel1Warning": { "css": "tr[data-parent-index='1'] .at-note--warning", "description": "Line 2: missing Finance Code warning" },
    "panel1Code": { "css": "#at-code-1", "description": "Line 2: line Finance Code select (select2)" },
    "panel1FromLine": { "css": "tr[data-parent-index='1'] .at-tagpanel__row .gs-tag--info", "description": "Line 2: 'from this line' badge" },
    "panel2Warning": { "css": "tr[data-parent-index='2'] .at-note--warning", "description": "Line 3: missing Finance Code warning" },
    "panel2KeepStandard": { "css": "tr[data-parent-index='2'] .at-note--warning button[data-storeops-set][data-value='standard']", "description": "Line 3: keep a standard tag" },
    "panel2StandardChosen": { "css": "tr[data-parent-index='2'] .at-note--info", "description": "Line 3: standard tag chosen note" },
    "anyPanel": { "css": "#gridBody .at-tagpanel", "description": "Any tag panel on the GRN" },

    "issuedBox": { "css": ".at-issued", "description": "Posted GRN: issued tags box" },
    "issuedSummary": { "css": ".at-issued .box-body > p.gs-muted", "description": "Posted GRN: 'Tags: N Govt. Tags · M standard'" },
    "issuedItems": { "css": ".at-issued__item", "description": "Posted GRN: one row per issued tag" },
    "issuedGovt": { "css": ".at-issued__item .gs-tag--primary", "description": "Posted GRN: Govt. Tag rows" },
    "issuedStandard": { "css": ".at-issued__item .gs-tag--secondary", "description": "Posted GRN: standard tag rows" },
    "issuedFirstGovtTag": { "css": ".at-issued__item:has(.gs-tag--primary) .at-issued__tag >> nth=0", "description": "Posted GRN: first Govt. Tag" },
    "issuedFirstStandardTag": { "css": ".at-issued__item:has(.gs-tag--secondary) .at-issued__tag >> nth=0", "description": "Posted GRN: first standard tag" },
    "issuedCsv": { "css": ".at-issued a[href$='issued.csv']", "description": "Posted GRN: download issued tags CSV" },
    "issuedPrint": { "css": ".at-issued button.at-issued__print", "description": "Posted GRN: print labels" }
  },
  "labels": { "en-US": {}, "bn-BD": {} }
}
